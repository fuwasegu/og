// og — Offline Go dependency library documentation lookup requirements (Issue #27)
//
// Source: GitHub issue #27 (module cache extraction & version-exact dependency search).
//   DOC-12a: Dependency documentation is extracted per `(modulePath, moduleVersion)` unit from
//            local Go module cache (`GOMODCACHE` / `$GOPATH/pkg/mod`) without automatic network
//            downloads (`go mod download` is never triggered automatically).
//   DOC-12b: Version exactness — only dependencies matching the active project's `go.mod`/`go.work`
//            versions are searchable as usable cards. Dependencies absent from module cache are
//            explicitly reported as uncached (`DepUncached`) and never substituted with another version.
//   DOC-12c: Project switching & `go.mod` updates switch the active dependency set and clear stale
//            answers; stdlib-only projects (`project_dep_ver == none`) never return dependency cards.
//   DOC-12d: Staged ingestion supports pause/resume/cancel without corrupting active dependency packs,
//            respects embedding model boundaries (`ReadyDepPackMatchesModel`), and stays strictly
//            on loopback (`NeverLeavesMachine`).
//
// ASSUME-1 (representation only): two dependency versions (0 = e.g. v1.8.0, 1 = e.g. v1.9.0)
//   and two embedding models are sufficient to expose version-mismatch, uncached-substitution,
//   project-switch, and model-mixing bugs.
requirements DocsDeps {
  number DepVer
  number ModelId

  enum Endpoint { Local, Remote }
  enum DepPackState { Missing, IndexingFTSOnly, Ready }
  enum DepBatchState { BIdle, BRunning, BPaused }
  enum DepAnswerKind { NoAnswer, DepCards, DepNotFound, DepUncached }

  state {
    enabled:              Bool,
    project_dep_ver:      Option<DepVer>,
    cache_present:        Map<DepVer, Bool>,
    pack_state:           Map<DepVer, DepPackState>,
    pack_model:           Map<DepVer, ModelId>,
    selected_model:       ModelId,
    batch_state:          DepBatchState,
    batch_ver:            Option<DepVer>,
    batch_model:          ModelId,
    answer_kind:          DepAnswerKind,
    answer_ver:           Option<DepVer>,
    answer_has_citation:  Bool,
    answer_has_scope:     Bool,
    answer_used_semantic: Bool,
    inserted:             Bool,
    sent_remote:          Bool,       // MODEL-1: ghost — data ever sent off-machine
    auto_downloaded:      Bool        // MODEL-2: ghost — unrequested network download
  }

  init {
    enabled = false
    project_dep_ver = none
    selected_model = 0
    batch_state = BIdle
    batch_ver = none
    batch_model = 0
    answer_kind = NoAnswer
    answer_ver = none
    answer_has_citation = false
    answer_has_scope = false
    answer_used_semantic = false
    inserted = false
    sent_remote = false
    auto_downloaded = false
    forall dv: DepVer {
      cache_present[dv] = false
      pack_state[dv] = Missing
      pack_model[dv] = 0
    }
  }

  action enable() "DOC-1: enable offline Go docs lookup" {
    requires not enabled
    enabled = true
  }

  action disable() "DOC-1: disable lookup and clear displayed dependency answers" {
    requires enabled
    enabled = false
    answer_kind = NoAnswer
    answer_ver = none
    answer_has_citation = false
    answer_has_scope = false
    answer_used_semantic = false
  }

  action set_project_dep(dv: DepVer) "DOC-12c: open project or update go.mod/go.work requiring dependency version dv" {
    requires project_dep_ver != some(dv)
    project_dep_ver = some(dv)
    answer_kind = NoAnswer
    answer_ver = none
    answer_has_citation = false
    answer_has_scope = false
    answer_used_semantic = false
  }

  action clear_project_dep() "DOC-12c: switch to a stdlib-only project with no external dependencies" {
    requires project_dep_ver != none
    project_dep_ver = none
    answer_kind = NoAnswer
    answer_ver = none
    answer_has_citation = false
    answer_has_scope = false
    answer_used_semantic = false
  }

  action set_cache_present(dv: DepVer, present: Bool) "DOC-12a: local module cache availability for version dv changes externally" {
    requires present != cache_present[dv]
    cache_present[dv] = present
    if answer_kind == DepUncached and answer_ver == some(dv) {
      answer_kind = NoAnswer
      answer_ver = none
      answer_has_citation = false
      answer_has_scope = false
      answer_used_semantic = false
    }
  }

  // MARK: - Staged, cancellable, resumable dependency pack ingestion (DOC-12a, DOC-12d)

  action start_dep_batch(dv: DepVer) "DOC-12a: start staged extraction for dependency version dv only when exact version exists in module cache" {
    requires batch_state == BIdle
    requires cache_present[dv]
    batch_state = BRunning
    batch_ver = some(dv)
    batch_model = selected_model
    auto_downloaded = auto_downloaded or not cache_present[dv]
  }

  action publish_dep_fts(dv: DepVer) "DOC-12d: publish initial FTS-only dependency pack while embeddings run" {
    requires batch_state == BRunning
    requires batch_ver == some(dv)
    requires batch_model == selected_model
    requires pack_state[dv] == Missing
    pack_state[dv] = IndexingFTSOnly
    if answer_kind == DepUncached and answer_ver == some(dv) {
      answer_kind = NoAnswer
      answer_ver = none
      answer_has_citation = false
      answer_has_scope = false
      answer_used_semantic = false
    }
  }

  action pause_dep_batch() "DOC-12d: pause a running dependency ingestion batch keeping active packs intact" {
    requires batch_state == BRunning
    batch_state = BPaused
  }

  action resume_dep_batch() "DOC-12d: resume a paused dependency ingestion batch for the same model" {
    requires batch_state == BPaused
    requires batch_model == selected_model
    batch_state = BRunning
  }

  action abort_dep_batch() "DOC-12d: cancel or abort a running/paused batch without corrupting active packs" {
    requires batch_state != BIdle
    batch_state = BIdle
    batch_ver = none
  }

  action complete_dep_batch(dv: DepVer) "DOC-12d: atomically activate Ready dependency pack for exact version dv" {
    requires batch_state == BRunning
    requires batch_ver == some(dv)
    requires batch_model == selected_model
    pack_state[dv] = Ready
    pack_model[dv] = selected_model
    batch_state = BIdle
    batch_ver = none
    if answer_kind == DepUncached and answer_ver == some(dv) {
      answer_kind = NoAnswer
      answer_ver = none
      answer_has_citation = false
      answer_has_scope = false
      answer_used_semantic = false
    }
  }

  action delete_dep_pack(dv: DepVer) "DOC-12d: remove dependency pack for dv and clear answers referencing it" {
    requires pack_state[dv] != Missing
    pack_state[dv] = Missing
    if batch_ver == some(dv) {
      batch_state = BIdle
      batch_ver = none
    }
    if answer_ver == some(dv) {
      answer_kind = NoAnswer
      answer_ver = none
      answer_has_citation = false
      answer_has_scope = false
      answer_used_semantic = false
    }
  }

  action select_embed_model(m: ModelId) "DOC-4: switching embedding model aborts incompatible batches and demotes Ready dependency packs to FTS-only" {
    requires m != selected_model
    selected_model = m
    batch_state = BIdle
    batch_ver = none
    forall dv: DepVer {
      if pack_state[dv] == Ready and pack_model[dv] != m {
        pack_state[dv] = IndexingFTSOnly
      }
    }
    if answer_used_semantic {
      answer_kind = NoAnswer
      answer_ver = none
      answer_has_citation = false
      answer_has_scope = false
      answer_used_semantic = false
    }
  }

  // MARK: - Version-exact dependency lookup (DOC-12b, DOC-12c)

  action query_dep_found(to: Endpoint, dv: DepVer, use_semantic: Bool) "DOC-12b: local query returns grounded dependency card(s) strictly matching project_dep_ver with module@version citation" {
    requires enabled
    requires to == Local
    requires project_dep_ver == some(dv)
    requires pack_state[dv] != Missing
    requires (not use_semantic) or (pack_state[dv] == Ready and pack_model[dv] == selected_model)
    answer_kind = DepCards
    answer_ver = some(dv)
    answer_has_citation = true
    answer_has_scope = true
    answer_used_semantic = use_semantic
    sent_remote = sent_remote or to == Remote
  }

  action query_dep_not_found(to: Endpoint, dv: DepVer) "DOC-12b: honest Not Found when active dependency pack has no matching symbol" {
    requires enabled
    requires to == Local
    requires project_dep_ver == some(dv)
    requires pack_state[dv] != Missing
    answer_kind = DepNotFound
    answer_ver = some(dv)
    answer_has_citation = false
    answer_has_scope = true
    answer_used_semantic = pack_state[dv] == Ready and pack_model[dv] == selected_model
    sent_remote = sent_remote or to == Remote
  }

  action query_dep_uncached(dv: DepVer) "DOC-12b: report uncached dependency explicitly without substituting another version or auto-downloading" {
    requires enabled
    requires project_dep_ver == some(dv)
    requires not cache_present[dv]
    requires pack_state[dv] == Missing
    answer_kind = DepUncached
    answer_ver = some(dv)
    answer_has_citation = false
    answer_has_scope = true
    answer_used_semantic = false
  }

  action insert_dep_card() "DOC-9: code insertion is permitted only for grounded cards matching the active project dependency version" {
    requires enabled
    requires answer_kind == DepCards
    requires answer_ver is some(dv) and project_dep_ver == some(dv)
    requires answer_has_citation
    inserted = true
  }

  // MARK: - Invariants

  invariant NeverLeavesMachine "DOC-6: dependency lookup never sends data off-machine" {
    not sent_remote
  }

  invariant NeverAutoDownloads "DOC-12a: uncached dependencies are never automatically downloaded without explicit user action" {
    not auto_downloaded
  }

  invariant DepCardsMatchActiveProjectVersion "DOC-12b: usable dependency cards strictly match the active project's go.mod/go.work version and an installed pack" {
    answer_kind == DepCards => (
      enabled and
      answer_ver is some(dv) and
      project_dep_ver == some(dv) and
      pack_state[dv] != Missing and
      answer_has_citation and
      answer_has_scope
    )
  }

  invariant StdlibOnlyProjectNeverReturnsDepCards "DOC-12c: projects without external dependencies never return dependency cards" {
    project_dep_ver == none => answer_kind != DepCards
  }

  invariant UncachedReportedWithoutSubstitution "DOC-12b: uncached reports never fabricate citations and only occur when the exact version is absent" {
    answer_kind == DepUncached => (
      enabled and
      answer_ver is some(dv) and
      project_dep_ver == some(dv) and
      not cache_present[dv] and
      pack_state[dv] == Missing and
      not answer_has_citation and
      answer_has_scope
    )
  }

  invariant ReadyDepPackMatchesModel "DOC-4: every Ready dependency pack was embedded with selected_model" {
    forall dv: DepVer { pack_state[dv] == Ready => pack_model[dv] == selected_model }
  }

  invariant SemanticRequiresMatchingModel "DOC-4: semantic search on dependency packs never mixes vectors from another embedding model" {
    answer_used_semantic => (
      answer_ver is some(dv) and
      pack_state[dv] == Ready and
      pack_model[dv] == selected_model
    )
  }

  invariant BatchTracksModel "MODEL-3: induction aid; active/paused dependency batch targets a version with selected_model" {
    (batch_state == BIdle => batch_ver == none) and
    (batch_state != BIdle => (batch_ver != none and batch_model == selected_model))
  }

  invariant DisabledHasNoAnswer "DOC-1: disabling lookup leaves no dependency answer displayed" {
    not enabled => answer_kind == NoAnswer
  }

  // MARK: - Acceptance & Forbidden traces

  acceptance AC-DEP-1 "DOC-12b: cached dependency is extracted, searched with citation, and inserted" {
    enable() set_project_dep(0) set_cache_present(0, true) start_dep_batch(0) publish_dep_fts(0) query_dep_found(Local, 0, false) insert_dep_card()
    expect answer_kind == DepCards and answer_ver == some(0) and answer_has_citation and inserted
  }

  acceptance AC-DEP-2 "DOC-12d: pausing and resuming or aborting a dependency batch preserves active Ready pack" {
    enable() set_project_dep(0) set_cache_present(0, true) start_dep_batch(0) complete_dep_batch(0) start_dep_batch(0) pause_dep_batch() abort_dep_batch()
    expect pack_state[0] == Ready and batch_state == BIdle
  }

  acceptance AC-DEP-3 "DOC-12c: switching project dependency version clears previous answer" {
    enable() set_project_dep(0) set_cache_present(0, true) start_dep_batch(0) publish_dep_fts(0) query_dep_found(Local, 0, false) set_project_dep(1)
    expect project_dep_ver == some(1) and answer_kind == NoAnswer and answer_ver == none
  }

  acceptance AC-DEP-4 "DOC-12b: uncached dependency is explicitly reported as DepUncached even when another version is installed" {
    enable() set_cache_present(1, true) start_dep_batch(1) complete_dep_batch(1) set_project_dep(0) query_dep_uncached(0)
    expect answer_kind == DepUncached and answer_ver == some(0) and not answer_has_citation
  }

  forbidden FB-DEP-1 "DOC-12b: dependency version not matching go.mod cannot be returned as usable even if installed" {
    enable() set_cache_present(1, true) start_dep_batch(1) complete_dep_batch(1) set_project_dep(0) query_dep_found(Local, 1, false)
    expect rejected
  }

  forbidden FB-DEP-2 "DOC-12c: stdlib-only project cannot return dependency cards" {
    enable() set_cache_present(0, true) start_dep_batch(0) complete_dep_batch(0) query_dep_found(Local, 0, false)
    expect rejected
  }

  forbidden FB-DEP-3 "DOC-12a: uncached dependency version cannot be extracted from module cache" {
    enable() set_project_dep(0) start_dep_batch(0)
    expect rejected
  }

  forbidden FB-DEP-4 "DOC-6: remote queries for dependency docs are refused" {
    enable() set_project_dep(0) set_cache_present(0, true) start_dep_batch(0) publish_dep_fts(0) query_dep_found(Remote, 0, false)
    expect rejected
  }
}

verify {
  values DepVer = 0..1
  values ModelId = 0..1
}
