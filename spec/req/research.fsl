// og — Offline Go documentation lookup / Docs RAG requirements
//
// Source: GitHub issue #18 (owner design decisions 2026-11-25, confirmed 2026-11-26).
//   DOC-1: Research / Go docs lookup is opt-in, independent of AI inline completion (FR-19).
//   DOC-2: Target Go version is resolved from the project (go.mod -> go.work -> toolchain);
//          results are version-gated both at pack level (never silently answer from another
//          version when the matching pack is missing) and at chunk `since` level (features
//          with `since > project_ver` are never returned as usable cards, only separated
//          as newer-version notes) (FR-2, FR-8, FR-10, §3, §7.4).
//   DOC-3: Pack ingestion supports initial build and updating an already-Ready pack with
//          atomic activation; cancellation, pause, or failure never corrupts an active pack
//          (FR-6, FR-22, FR-23, FR-26).
//   DOC-4: Pack ingestion is pauseable/resumable and incremental; changing the embedding
//          model demotes Ready packs to FTS-only until rebuilt so vectors from different
//          models are never mixed (FR-25, FR-26, FR-27, FR-28).
//   DOC-5: Shared vector store keyed by (content hash, model id/version) allows a new
//          version or update batch to reuse cached vectors instead of recomputing (FR-30, FR-31).
//   DOC-6: All communication stays on loopback; project code never leaves the machine (FR-16, FR-17).
//   DOC-7: Grounded cards always carry citation, Go version, and `since <= project_ver`;
//          Not Found answers carry the searched scope (without fabricating citations or symbols)
//          (FR-12..14, UX-4).
//   DOC-8: Search works offline without an LLM (FTS5 + deterministic excerpts) (FR-15, FR-28).
//   DOC-9: Code insertion into the editor is allowed only for grounded, version-gated cards
//          matching the current project version (UX-2).
//
// ASSUME-1 (representation only): two Go versions (0 = older e.g. 1.21, 1 = newer e.g. 1.23)
//   and two embedding models are sufficient to expose pack-level, chunk-`since`, and model bugs.
// ASSUME-2 (confirmed 2026-11-26): Research is specified independently of ModelServer (which
//   governs the inline completion server); both share D-9 (og-owned loopback servers only).
//   Phase 1 runs completely offline without a generation/embedding server, using a temporary
//   data-driven concept dictionary for Japanese-to-English FTS5 expansion until Phase 2
//   cross-lingual embeddings replace/augment it. Phase 2 will add server lifecycle supervision
//   for research models under the same D-9 contract.
requirements Research {
  number GoVer
  number ModelId

  enum Endpoint { Local, Remote }
  enum PackState { Missing, IndexingFTSOnly, Ready }
  enum BatchState { BIdle, BRunning, BPaused }
  enum AnswerKind { NoAnswer, GroundedCards, GroundedNotFound, MissingPack }

  state {
    enabled:                 Bool,
    project_ver:             GoVer,
    pack_state:              Map<GoVer, PackState>,
    pack_model:              Map<GoVer, ModelId>,
    selected_model:          ModelId,
    // DOC-3 / DOC-4: observable ingestion batch lifecycle (initial + Ready pack update)
    batch_state:             BatchState,
    batch_ver:               Option<GoVer>,
    batch_model:             ModelId,
    // DOC-5: shared vector store state & whether the last completed batch reused cached vectors
    shared_cached:           Bool,
    shared_model:            ModelId,
    last_batch_reused:       Bool,
    llm_available:           Bool,
    // DOC-2 / DOC-7 / DOC-9: answer state
    answer_kind:             AnswerKind,
    answer_ver:              Option<GoVer>,
    answer_card_since:       Option<GoVer>,
    answer_has_newer_notes:  Bool,
    answer_has_citation:     Bool,
    answer_has_scope:        Bool,
    answer_grounded:         Bool,
    answer_used_semantic:    Bool,
    inserted:                Bool,
    sent_remote:             Bool       // MODEL-1: ghost — data ever sent off-machine
  }

  init {
    enabled = false
    project_ver = 0
    selected_model = 0
    batch_state = BIdle
    batch_ver = none
    batch_model = 0
    shared_cached = false
    shared_model = 0
    last_batch_reused = false
    llm_available = false
    answer_kind = NoAnswer
    answer_ver = none
    answer_card_since = none
    answer_has_newer_notes = false
    answer_has_citation = false
    answer_has_scope = false
    answer_grounded = false
    answer_used_semantic = false
    inserted = false
    sent_remote = false
    forall v: GoVer {
      pack_state[v] = Missing
      pack_model[v] = 0
    }
  }

  action enable() "DOC-1: user opts in to offline Go docs lookup" {
    requires not enabled
    enabled = true
  }

  action disable() "DOC-1: disabling docs lookup clears displayed answers" {
    requires enabled
    enabled = false
    answer_kind = NoAnswer
    answer_ver = none
    answer_card_since = none
    answer_has_newer_notes = false
    answer_has_citation = false
    answer_has_scope = false
    answer_grounded = false
    answer_used_semantic = false
  }

  action set_project_version(v: GoVer) "DOC-2: project Go version changes; previous version's answers are cleared" {
    requires v != project_ver
    project_ver = v
    answer_kind = NoAnswer
    answer_ver = none
    answer_card_since = none
    answer_has_newer_notes = false
    answer_has_citation = false
    answer_has_scope = false
    answer_grounded = false
    answer_used_semantic = false
  }

  action toggle_llm(avail: Bool) "DOC-8: local answer-generation LLM availability changes independently of search" {
    requires avail != llm_available
    llm_available = avail
  }

  // MARK: - Pack ingestion & update contract (DOC-3, DOC-4, DOC-5)

  action start_batch(v: GoVer) "DOC-3: start initial ingestion or update of an existing (including Ready) pack without disturbing active state" {
    requires batch_state == BIdle
    batch_state = BRunning
    batch_ver = some(v)
    batch_model = selected_model
  }

  action publish_fts_pack(v: GoVer) "DOC-3: during initial ingestion, publish FTS-only search while embeddings run" {
    requires batch_state == BRunning
    requires batch_ver == some(v)
    requires batch_model == selected_model
    requires pack_state[v] == Missing
    pack_state[v] = IndexingFTSOnly
    if v == project_ver and answer_kind == MissingPack {
      answer_kind = NoAnswer
      answer_ver = none
      answer_card_since = none
      answer_has_newer_notes = false
      answer_has_citation = false
      answer_has_scope = false
      answer_grounded = false
      answer_used_semantic = false
    }
  }

  action pause_batch() "DOC-4: cancel or pause an active batch while keeping any active pack intact" {
    requires batch_state == BRunning
    batch_state = BPaused
  }

  action resume_batch() "DOC-4: resume a paused batch for the same model without redoing finished work" {
    requires batch_state == BPaused
    requires batch_model == selected_model
    batch_state = BRunning
  }

  action abort_batch() "DOC-3: fail or discard a running/paused batch without corrupting any active pack" {
    requires batch_state != BIdle
    batch_state = BIdle
    batch_ver = none
  }

  action complete_batch_compute(v: GoVer) "DOC-3: atomically activate a new or updated pack after computing embeddings" {
    requires batch_state == BRunning
    requires batch_ver == some(v)
    requires batch_model == selected_model
    pack_state[v] = Ready
    pack_model[v] = selected_model
    shared_cached = true
    shared_model = selected_model
    last_batch_reused = false
    batch_state = BIdle
    batch_ver = none
    if v == project_ver and answer_kind == MissingPack {
      answer_kind = NoAnswer
      answer_ver = none
      answer_card_since = none
      answer_has_newer_notes = false
      answer_has_citation = false
      answer_has_scope = false
      answer_grounded = false
      answer_used_semantic = false
    }
  }

  action complete_batch_reuse(v: GoVer) "DOC-5: atomically activate a pack reusing matching vectors from the shared store" {
    requires batch_state == BRunning
    requires batch_ver == some(v)
    requires batch_model == selected_model
    requires shared_cached and shared_model == selected_model
    pack_state[v] = Ready
    pack_model[v] = selected_model
    last_batch_reused = true
    batch_state = BIdle
    batch_ver = none
    if v == project_ver and answer_kind == MissingPack {
      answer_kind = NoAnswer
      answer_ver = none
      answer_card_since = none
      answer_has_newer_notes = false
      answer_has_citation = false
      answer_has_scope = false
      answer_grounded = false
      answer_used_semantic = false
    }
  }

  action delete_pack(v: GoVer) "DOC-3: removing a pack cancels any batch for v and clears answers bound to v" {
    requires pack_state[v] != Missing
    pack_state[v] = Missing
    if batch_ver == some(v) {
      batch_state = BIdle
      batch_ver = none
    }
    if v == project_ver {
      answer_kind = NoAnswer
      answer_ver = none
      answer_card_since = none
      answer_has_newer_notes = false
      answer_has_citation = false
      answer_has_scope = false
      answer_grounded = false
      answer_used_semantic = false
    }
  }

  action select_embed_model(m: ModelId) "DOC-4: switching the embedding model aborts incompatible batches and demotes Ready packs to FTS-only" {
    requires m != selected_model
    selected_model = m
    batch_state = BIdle
    batch_ver = none
    last_batch_reused = false
    forall v: GoVer {
      if pack_state[v] == Ready and pack_model[v] != m {
        pack_state[v] = IndexingFTSOnly
      }
    }
    if answer_used_semantic {
      answer_kind = NoAnswer
      answer_ver = none
      answer_card_since = none
      answer_has_newer_notes = false
      answer_has_citation = false
      answer_has_scope = false
      answer_grounded = false
      answer_used_semantic = false
    }
  }

  // MARK: - Grounded version-gated lookup (DOC-2, DOC-6, DOC-7, DOC-8, DOC-9)

  action query_found(to: Endpoint, card_since: GoVer, has_newer_feature: Bool) "DOC-7: local query returns grounded, cited cards with card_since <= project_ver; newer features are separated into notes" {
    requires enabled
    requires to == Local
    requires pack_state[project_ver] != Missing
    requires card_since <= project_ver
    answer_kind = GroundedCards
    answer_ver = some(project_ver)
    answer_card_since = some(card_since)
    answer_has_newer_notes = has_newer_feature
    answer_has_citation = true
    answer_has_scope = true
    answer_grounded = true
    answer_used_semantic = pack_state[project_ver] == Ready and pack_model[project_ver] == selected_model
    sent_remote = sent_remote or to == Remote
  }

  action query_not_found(to: Endpoint, has_newer_feature: Bool) "DOC-7: when no chunk matches for project_ver, answer Not Found with searched scope and no fabricated citation/symbol" {
    requires enabled
    requires to == Local
    requires pack_state[project_ver] != Missing
    answer_kind = GroundedNotFound
    answer_ver = some(project_ver)
    answer_card_since = none
    answer_has_newer_notes = has_newer_feature
    answer_has_citation = false
    answer_has_scope = true
    answer_grounded = true
    answer_used_semantic = pack_state[project_ver] == Ready and pack_model[project_ver] == selected_model
    sent_remote = sent_remote or to == Remote
  }

  action query_missing_pack() "DOC-2: when the project's Go version pack is absent, report missing pack instead of answering from another version" {
    requires enabled
    requires pack_state[project_ver] == Missing
    answer_kind = MissingPack
    answer_ver = some(project_ver)
    answer_card_since = none
    answer_has_newer_notes = false
    answer_has_citation = false
    answer_has_scope = true
    answer_grounded = true
    answer_used_semantic = false
  }

  action insert_card() "DOC-9: code insertion is permitted only for grounded, since-gated cards of the current project version" {
    requires enabled
    requires answer_kind == GroundedCards
    requires answer_ver == some(project_ver)
    requires answer_card_since is some(s) and s <= project_ver
    requires answer_grounded
    inserted = true
  }

  // MARK: - Invariants

  invariant NeverLeavesMachine "DOC-6: queries and project context are never sent to a remote endpoint" {
    not sent_remote
  }

  invariant CardsAlwaysCitedAndVersionGated "DOC-7: every grounded card has citation, scope, and since <= project_ver" {
    answer_kind == GroundedCards => (
      answer_has_citation and answer_has_scope and answer_grounded and
      answer_card_since is some(s) and s <= project_ver
    )
  }

  invariant NotFoundHasScopeWithoutFabricatedCitation "DOC-7: Not Found answers report searched scope without claiming a symbol citation" {
    answer_kind == GroundedNotFound => (
      answer_grounded and answer_has_scope and not answer_has_citation and
      answer_card_since == none and answer_ver == some(project_ver)
    )
  }

  invariant AnswerMatchesProjectVersion "DOC-2: any displayed result matches the active project Go version" {
    answer_kind != NoAnswer => answer_ver == some(project_ver)
  }

  invariant NeverAnswersWithoutMatchingPack "DOC-2: grounded answers require an installed pack for project_ver" {
    (answer_kind == GroundedCards or answer_kind == GroundedNotFound) => pack_state[project_ver] != Missing
  }

  invariant SemanticRequiresMatchingModel "DOC-4: semantic search never mixes vectors from a different embedding model" {
    answer_used_semantic => (pack_state[project_ver] == Ready and pack_model[project_ver] == selected_model)
  }

  invariant ReadyPackMatchesModel "DOC-4: every Ready pack was embedded with the currently selected model" {
    forall v: GoVer { pack_state[v] == Ready => pack_model[v] == selected_model }
  }

  invariant ReuseRequiresMatchingCache "DOC-5: vector reuse only occurs when the shared store holds vectors for selected_model" {
    last_batch_reused => (shared_cached and shared_model == selected_model)
  }

  invariant BatchTracksModel "MODEL-2: induction aid; an active/paused batch targets a version with selected_model" {
    (batch_state == BIdle => batch_ver == none) and
    (batch_state != BIdle => (batch_ver != none and batch_model == selected_model))
  }

  invariant DisabledHasNoAnswer "DOC-1: disabling lookup leaves no answer displayed" {
    not enabled => answer_kind == NoAnswer
  }

  // MARK: - Acceptance & Forbidden traces

  acceptance AC-DOC-1 "DOC-8: offline FTS-only query without LLM returns cited, version-gated cards and allows insertion" {
    enable() start_batch(0) publish_fts_pack(0) query_found(Local, 0, true) insert_card()
    expect answer_kind == GroundedCards and answer_has_citation and answer_has_newer_notes and not answer_used_semantic and inserted
  }

  acceptance AC-DOC-2 "DOC-5: second Go version pack reuses cached vectors from the shared store" {
    enable() start_batch(0) complete_batch_compute(0) start_batch(1) complete_batch_reuse(1)
    expect pack_state[1] == Ready and last_batch_reused
  }

  acceptance AC-DOC-3 "DOC-2: missing pack for project_ver reports MissingPack even if another version is installed" {
    enable() start_batch(1) complete_batch_compute(1) query_missing_pack()
    expect answer_kind == MissingPack and answer_ver == some(0)
  }

  acceptance AC-DOC-4 "DOC-7: unmatched query reports GroundedNotFound with searched scope and no citation" {
    enable() start_batch(0) publish_fts_pack(0) query_not_found(Local, false)
    expect answer_kind == GroundedNotFound and answer_has_scope and not answer_has_citation
  }

  acceptance AC-DOC-5 "DOC-4: switching embedding model demotes Ready pack to FTS-only until rebuilt" {
    enable() start_batch(0) complete_batch_compute(0) select_embed_model(1) start_batch(0) complete_batch_compute(0)
    expect pack_state[0] == Ready and pack_model[0] == 1
  }

  acceptance AC-DOC-6 "DOC-3: updating an already-Ready pack and aborting leaves the active Ready pack intact and queryable" {
    enable() start_batch(0) complete_batch_compute(0) start_batch(0) pause_batch() abort_batch() query_found(Local, 0, false)
    expect pack_state[0] == Ready and answer_kind == GroundedCards and answer_used_semantic
  }

  acceptance AC-DOC-7 "DOC-3: updating an already-Ready pack to completion atomically swaps while reusing cached vectors" {
    enable() start_batch(0) complete_batch_compute(0) start_batch(0) complete_batch_reuse(0) query_found(Local, 0, false)
    expect pack_state[0] == Ready and pack_model[0] == 0 and last_batch_reused and answer_used_semantic
  }

  forbidden FB-DOC-1 "DOC-6: queries to a remote endpoint are refused" {
    enable() start_batch(0) publish_fts_pack(0) query_found(Remote, 0, false)
    expect rejected
  }

  forbidden FB-DOC-2 "DOC-2: cannot answer from version 1 pack when project_ver is 0" {
    enable() start_batch(1) complete_batch_compute(1) query_found(Local, 0, false)
    expect rejected
  }

  forbidden FB-DOC-3 "DOC-9: cannot insert code from a Not Found answer" {
    enable() start_batch(0) publish_fts_pack(0) query_not_found(Local, false) insert_card()
    expect rejected
  }

  forbidden FB-DOC-4 "DOC-1: cannot query while docs lookup is disabled" {
    start_batch(0) publish_fts_pack(0) query_found(Local, 0, false)
    expect rejected
  }

  forbidden FB-DOC-5 "DOC-9: cannot insert stale card after switching project version" {
    enable() start_batch(0) publish_fts_pack(0) query_found(Local, 0, false) set_project_version(1) insert_card()
    expect rejected
  }

  forbidden FB-DOC-6 "DOC-2: cannot return a card whose since version exceeds project_ver" {
    enable() start_batch(0) publish_fts_pack(0) query_found(Local, 1, false)
    expect rejected
  }
}

verify {
  values GoVer = 0..1
  values ModelId = 0..1
}
