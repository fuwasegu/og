// og — Offline Go documentation lookup / Docs RAG requirements
//
// Source: GitHub issue #18 (owner design decisions 2026-11-25, confirmed 2026-11-26).
//   DOC-1: Research / Go docs lookup is opt-in, independent of AI inline completion (FR-19).
//   DOC-2: Target Go version is resolved from the project (go.mod -> go.work -> toolchain);
//          results are version-gated and never silently answered from another Go version
//          when the matching pack is missing (FR-2, FR-10, §7.4).
//   DOC-3: Pack ingestion runs in a staging area and switches atomically; cancellation or
//          failure leaves any previously active pack intact (FR-6, FR-22, FR-23).
//   DOC-4: Pack ingestion is resumable and incremental; changing the embedding model
//          invalidates semantic search until rebuilt so vectors from different models are
//          never mixed (FR-25, FR-26, FR-27, FR-28).
//   DOC-5: Vectors are stored in a shared vector store keyed by (content hash, model id/ver)
//          so unchanged chunks are reused across Go versions without recomputation (FR-30, FR-31).
//   DOC-6: All communication stays on loopback; project code never leaves the machine (FR-16, FR-17).
//   DOC-7: Answers are strictly grounded in retrieved chunks with citation and Go version;
//          when nothing matches, "not found" is stated without fabricating symbols (FR-12..14, UX-4).
//   DOC-8: Search works offline without an LLM (FTS5 + deterministic excerpts with citations) (FR-15, FR-28).
//   DOC-9: Code insertion into the editor is allowed only for grounded, version-gated cards (UX-2).
//
// ASSUME-1 (representation only): two Go versions (0 = older e.g. 1.21, 1 = newer e.g. 1.23)
//   and two embedding models are sufficient to expose version-gate and model-mismatch bugs.
// ASSUME-2 (confirmed 2026-11-26): Research is modeled independently of ModelServer (completion);
//   both share D-9 (og-owned loopback servers only).
requirements Research {
  number GoVer
  number ModelId

  enum Endpoint { Local, Remote }
  enum PackState { Missing, IndexingFTSOnly, Ready }
  enum AnswerKind { NoAnswer, GroundedCards, GroundedNotFound, MissingPack }

  state {
    enabled:              Bool,
    project_ver:          GoVer,
    pack_state:           Map<GoVer, PackState>,
    pack_model:           Map<GoVer, ModelId>,
    selected_model:       ModelId,
    shared_cached:        Bool,
    shared_model:         ModelId,
    llm_available:        Bool,
    answer_kind:          AnswerKind,
    answer_ver:           Option<GoVer>,
    answer_has_citation:  Bool,
    answer_grounded:      Bool,
    answer_version_gated: Bool,
    answer_used_semantic: Bool,
    inserted:             Bool,
    sent_remote:          Bool       // MODEL-1: ghost — data ever sent off-machine
  }

  init {
    enabled = false
    project_ver = 0
    selected_model = 0
    shared_cached = false
    shared_model = 0
    llm_available = false
    answer_kind = NoAnswer
    answer_ver = none
    answer_has_citation = false
    answer_grounded = false
    answer_version_gated = false
    answer_used_semantic = false
    inserted = false
    sent_remote = false
    forall v: GoVer {
      pack_state[v] = Missing
      pack_model[v] = 0
    }
  }

  action enable() "DOC-1: user opts in to offline Go docs lookup" {
    requires not enabled
    enabled = true
  }

  action disable() "DOC-1: disabling docs lookup clears displayed answers" {
    requires enabled
    enabled = false
    answer_kind = NoAnswer
    answer_ver = none
    answer_has_citation = false
    answer_grounded = false
    answer_version_gated = false
    answer_used_semantic = false
  }

  action set_project_version(v: GoVer) "DOC-2: project Go version changes; previous version's answers are cleared" {
    requires v != project_ver
    project_ver = v
    answer_kind = NoAnswer
    answer_ver = none
    answer_has_citation = false
    answer_grounded = false
    answer_version_gated = false
    answer_used_semantic = false
  }

  action toggle_llm(avail: Bool) "DOC-8: local answer-generation LLM availability changes independently of search" {
    requires avail != llm_available
    llm_available = avail
  }

  action publish_fts_pack(v: GoVer) "DOC-3: while embeddings are building, the pack becomes searchable via FTS only" {
    requires pack_state[v] == Missing
    pack_state[v] = IndexingFTSOnly
    if v == project_ver and answer_kind == MissingPack {
      answer_kind = NoAnswer
      answer_ver = none
      answer_has_citation = false
      answer_grounded = false
      answer_version_gated = false
      answer_used_semantic = false
    }
  }

  action complete_pack(v: GoVer) "DOC-3: atomic activation once extraction, FTS and embeddings finish for selected_model" {
    requires pack_state[v] != Ready
    pack_state[v] = Ready
    pack_model[v] = selected_model
    shared_cached = true
    shared_model = selected_model
    if v == project_ver and answer_kind == MissingPack {
      answer_kind = NoAnswer
      answer_ver = none
      answer_has_citation = false
      answer_grounded = false
      answer_version_gated = false
      answer_used_semantic = false
    }
  }

  action delete_pack(v: GoVer) "DOC-3: removing a pack clears answers bound to that version" {
    requires pack_state[v] != Missing
    pack_state[v] = Missing
    if v == project_ver {
      answer_kind = NoAnswer
      answer_ver = none
      answer_has_citation = false
      answer_grounded = false
      answer_version_gated = false
      answer_used_semantic = false
    }
  }

  action select_embed_model(m: ModelId) "DOC-4: switching the embedding model disables semantic search on packs built with another model" {
    requires m != selected_model
    selected_model = m
    forall v: GoVer {
      if pack_state[v] == Ready and pack_model[v] != m {
        pack_state[v] = IndexingFTSOnly
      }
    }
    if answer_used_semantic {
      answer_kind = NoAnswer
      answer_ver = none
      answer_has_citation = false
      answer_grounded = false
      answer_version_gated = false
      answer_used_semantic = false
    }
  }

  action query_found(to: Endpoint) "DOC-7: local query against the project's Go version returns grounded, cited, version-gated cards" {
    requires enabled
    requires to == Local
    requires pack_state[project_ver] != Missing
    answer_kind = GroundedCards
    answer_ver = some(project_ver)
    answer_has_citation = true
    answer_grounded = true
    answer_version_gated = true
    answer_used_semantic = pack_state[project_ver] == Ready and pack_model[project_ver] == selected_model
    sent_remote = sent_remote or to == Remote
  }

  action query_not_found(to: Endpoint) "DOC-7: when no chunk matches in the project's version pack, answer Not Found with scope and no hallucinated symbol" {
    requires enabled
    requires to == Local
    requires pack_state[project_ver] != Missing
    answer_kind = GroundedNotFound
    answer_ver = some(project_ver)
    answer_has_citation = true
    answer_grounded = true
    answer_version_gated = true
    answer_used_semantic = pack_state[project_ver] == Ready and pack_model[project_ver] == selected_model
    sent_remote = sent_remote or to == Remote
  }

  action query_missing_pack() "DOC-2: when the project's Go version pack is absent, report missing pack instead of answering from another version" {
    requires enabled
    requires pack_state[project_ver] == Missing
    answer_kind = MissingPack
    answer_ver = some(project_ver)
    answer_has_citation = false
    answer_grounded = true
    answer_version_gated = false
    answer_used_semantic = false
  }

  action insert_card() "DOC-9: code insertion is permitted only for grounded, version-gated cards of the current project version" {
    requires enabled
    requires answer_kind == GroundedCards
    requires answer_ver == some(project_ver)
    requires answer_grounded
    requires answer_version_gated
    inserted = true
  }

  invariant NeverLeavesMachine "DOC-6: queries and project context are never sent to a remote endpoint" {
    not sent_remote
  }

  invariant CardsAlwaysCitedAndGrounded "DOC-7: every answer card has citation, grounding, and version gate" {
    answer_kind == GroundedCards => (answer_has_citation and answer_grounded and answer_version_gated)
  }

  invariant NotFoundAlwaysGrounded "DOC-7: Not Found answers are grounded in the searched version scope" {
    answer_kind == GroundedNotFound => (answer_grounded and answer_has_citation and answer_ver == some(project_ver))
  }

  invariant AnswerMatchesProjectVersion "DOC-2: any displayed result matches the active project Go version" {
    answer_kind != NoAnswer => answer_ver == some(project_ver)
  }

  invariant NeverAnswersWithoutMatchingPack "DOC-2: grounded answers require an installed pack for project_ver" {
    (answer_kind == GroundedCards or answer_kind == GroundedNotFound) => pack_state[project_ver] != Missing
  }

  invariant SemanticRequiresMatchingModel "DOC-4: semantic search never mixes vectors from a different embedding model" {
    answer_used_semantic => (pack_state[project_ver] == Ready and pack_model[project_ver] == selected_model)
  }

  invariant ReadyPackMatchesModel "DOC-4: every Ready pack was embedded with the currently selected model" {
    forall v: GoVer { pack_state[v] == Ready => pack_model[v] == selected_model }
  }

  invariant DisabledHasNoAnswer "DOC-1: disabling lookup leaves no answer displayed" {
    not enabled => answer_kind == NoAnswer
  }

  acceptance AC-DOC-1 "DOC-8: offline FTS-only query without LLM returns cited cards and allows insertion" {
    enable() publish_fts_pack(0) query_found(Local) insert_card()
    expect answer_kind == GroundedCards and answer_has_citation and not answer_used_semantic and inserted
  }

  acceptance AC-DOC-2 "DOC-3: completed pack enables semantic search and reuses shared vector store" {
    enable() complete_pack(0) query_found(Local)
    expect answer_kind == GroundedCards and answer_used_semantic and shared_cached
  }

  acceptance AC-DOC-3 "DOC-2: missing pack for project_ver reports MissingPack even if another version is installed" {
    enable() complete_pack(1) query_missing_pack()
    expect answer_kind == MissingPack and answer_ver == some(0)
  }

  acceptance AC-DOC-4 "DOC-7: unmatched query reports GroundedNotFound" {
    enable() publish_fts_pack(0) query_not_found(Local)
    expect answer_kind == GroundedNotFound and answer_grounded
  }

  forbidden FB-DOC-1 "DOC-6: queries to a remote endpoint are refused" {
    enable() publish_fts_pack(0) query_found(Remote)
    expect rejected
  }

  forbidden FB-DOC-2 "DOC-2: cannot answer from version 1 pack when project_ver is 0" {
    enable() complete_pack(1) query_found(Local)
    expect rejected
  }

  forbidden FB-DOC-3 "DOC-9: cannot insert code from a Not Found answer" {
    enable() publish_fts_pack(0) query_not_found(Local) insert_card()
    expect rejected
  }

  forbidden FB-DOC-4 "DOC-1: cannot query while docs lookup is disabled" {
    publish_fts_pack(0) query_found(Local)
    expect rejected
  }
}

verify {
  values GoVer = 0..1
  values ModelId = 0..1
}
