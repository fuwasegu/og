// og — Offline Go dependency library documentation lookup design (GoModuleResolver + DocsPackManager + ResearchService)
//
// Refines: spec/req/docs_deps.fsl (mapping: spec/design/docs_deps_refines_req.fsl)
//
// DES-DEP-1: Dependency packs are stored per `(modulePath, moduleVersion)` unit under
//            `packs/deps/<hash>/` (for local `replace` directives, the storage key also hashes
//            the resolved local directory path so distinct local replaces never collide) with
//            `manifest.json` + `index.sqlite` and share vectors via `SharedVectorStore` keyed by
//            `(content_hash, model_id, model_version)` so unchanged symbols across versions reuse
//            embeddings without recomputation. Unused dependency packs can be pruned explicitly.
// DES-DEP-2: Active dependencies for a project are resolved from `go.mod` / `go.work` (including
//            semver MVS and `replace` directives — in workspace mode `go.work` replaces govern)
//            and matched strictly against local `GOMODCACHE` using Go's `!`-lowercase path
//            escaping. Uncached dependencies are marked `.uncached`, cached-but-unindexed as
//            `.unindexed`, and never substituted with another version or auto-downloaded.
//            Fetching an uncached dependency (`user_fetch_dependency`) runs `go mod download`
//            strictly on explicit user action.
// DES-DEP-3: Ingestion uses the same GoDoc + Example extractor as stdlib (skipping nested
//            submodules with `go.mod`, `internal/`, `vendor/`, `testdata/`, `cmd/`, and `package main`),
//            enforces per-module file/byte/chunk extraction budgets with cooperative cancellation
//            (recording truncation in manifest/report), publishes FTS-only before Ready on initial
//            build, checkpoints chunks (`chunks_done`) for pause/resume/cancel, and activates atomically.
// DES-DEP-4: License attribution — detect a concise SPDX-style license identifier (MIT, Apache-2.0,
//            BSD-3-Clause, BSD-2-Clause, ISC, MPL-2.0, etc.) from the module root LICENSE/COPYING
//            file and store it in manifest and chunk/card metadata for lightweight citation display
//            without duplicating full license prose in SQLite.
// DES-DEP-5: Retrieval integration — stdlib definitions retain tie-breaking priority over dependency
//            symbols on exact collisions; corrupt dependency pack indexes degrade cleanly to
//            unindexed without failing stdlib lookup; dependency-grounded Phase 3 snippets are
//            marked `.unverified` with an accurate external-dependency reason instead of `.failed`.
//
// ASSUME-1 (representation only): two modules, two versions (`ModSlot = m * NUM_VERS + v`),
//   two embedding models, `TOTAL_CHUNKS = 1`, `MAX_CARDS = 3`.
spec DocsDepsDesign {
  number ModuleId
  number DepVer
  number ModSlot
  number ModelId
  number ChunkDone
  number CardCount
  const NUM_VERS = 2
  const TOTAL_CHUNKS = 1
  const MAX_CARDS = 3

  enum Host { Loopback, Elsewhere }
  enum DDepPackState { DMissing, DFTSOnly, DReady }
  enum DDepStagePhase { DIdle, DExtracting, DFTSBuilt, DEmbedded }
  enum DDepAnswerKind { DNoAnswer, DDepCards, DDepNotFound, DDepUnindexed, DDepUncached }

  state {
    endpoint:             Host,
    enabled:              Bool,
    project_dep_ver:      Map<ModuleId, Option<DepVer>>,
    cache_present:        Map<ModSlot, Bool>,
    pack_state:           Map<ModSlot, DDepPackState>,
    pack_model:           Map<ModSlot, ModelId>,
    selected_model:       ModelId,
    // DES-DEP-3: staging & chunk-level resumable batch state
    batch_slot:           Option<ModSlot>,
    stage_phase:          DDepStagePhase,
    batch_model:          ModelId,
    batch_paused:         Bool,
    chunks_done:          ChunkDone,
    // Answer state
    answer_kind:          DDepAnswerKind,
    answer_mod:           Option<ModuleId>,
    answer_ver:           Option<DepVer>,
    answer_card_count:    CardCount,
    answer_has_citation:  Bool,
    answer_has_scope:     Bool,
    answer_grounded:      Bool,
    answer_used_semantic: Bool,
    inserted:             Bool,
    sent_remote:          Bool,
    auto_downloaded:      Bool,
    explicit_fetched:     Bool
  }

  init {
    endpoint = Loopback
    enabled = false
    selected_model = 0
    batch_slot = none
    stage_phase = DIdle
    batch_model = 0
    batch_paused = false
    chunks_done = 0
    answer_kind = DNoAnswer
    answer_mod = none
    answer_ver = none
    answer_card_count = 0
    answer_has_citation = false
    answer_has_scope = false
    answer_grounded = false
    answer_used_semantic = false
    inserted = false
    sent_remote = false
    auto_downloaded = false
    explicit_fetched = false
    forall m: ModuleId {
      project_dep_ver[m] = none
    }
    forall s: ModSlot {
      cache_present[s] = false
      pack_state[s] = DMissing
      pack_model[s] = 0
    }
  }

  action set_endpoint(h: Host) "DES-DEP-1: only loopback endpoints are accepted" {
    requires h == Loopback
    endpoint = h
  }

  action enable() "DES-DEP-1: enable offline Go docs lookup" {
    requires not enabled
    enabled = true
  }

  action disable() "DES-DEP-1: disable lookup and clear answers" {
    requires enabled
    enabled = false
    answer_kind = DNoAnswer
    answer_mod = none
    answer_ver = none
    answer_card_count = 0
    answer_has_citation = false
    answer_has_scope = false
    answer_grounded = false
    answer_used_semantic = false
  }

  action set_project_dep(m: ModuleId, dv: DepVer) "DES-DEP-2: resolve active dependency (m, dv) from project go.mod/go.work and clear stale answers" {
    requires project_dep_ver[m] != some(dv)
    project_dep_ver[m] = some(dv)
    answer_kind = DNoAnswer
    answer_mod = none
    answer_ver = none
    answer_card_count = 0
    answer_has_citation = false
    answer_has_scope = false
    answer_grounded = false
    answer_used_semantic = false
  }

  action clear_project_dep(m: ModuleId) "DES-DEP-2: remove module m from active project dependencies" {
    requires project_dep_ver[m] != none
    project_dep_ver[m] = none
    answer_kind = DNoAnswer
    answer_mod = none
    answer_ver = none
    answer_card_count = 0
    answer_has_citation = false
    answer_has_scope = false
    answer_grounded = false
    answer_used_semantic = false
  }

  action set_cache_present(m: ModuleId, dv: DepVer, present: Bool) "DES-DEP-2: observe local GOMODCACHE presence" {
    requires present != cache_present[m * NUM_VERS + dv]
    cache_present[m * NUM_VERS + dv] = present
    if (answer_kind == DDepUncached or answer_kind == DDepUnindexed) and answer_mod == some(m) and answer_ver == some(dv) {
      answer_kind = DNoAnswer
      answer_mod = none
      answer_ver = none
      answer_card_count = 0
      answer_has_citation = false
      answer_has_scope = false
      answer_grounded = false
      answer_used_semantic = false
    }
  }

  action user_fetch_dependency(m: ModuleId, dv: DepVer) "DES-DEP-2: explicit user-triggered go mod download populates local GOMODCACHE" {
    requires enabled
    requires project_dep_ver[m] == some(dv)
    requires not cache_present[m * NUM_VERS + dv]
    cache_present[m * NUM_VERS + dv] = true
    explicit_fetched = true
    if answer_kind == DDepUncached and answer_mod == some(m) and answer_ver == some(dv) {
      answer_kind = DNoAnswer
      answer_mod = none
      answer_ver = none
      answer_card_count = 0
      answer_has_citation = false
      answer_has_scope = false
      answer_grounded = false
      answer_used_semantic = false
    }
  }

  // MARK: - Staged, chunk-checkpointed dependency ingestion (DES-DEP-3)

  action batch_start(m: ModuleId, dv: DepVer) "DES-DEP-3: begin staged module extraction from verified GOMODCACHE directory" {
    requires stage_phase == DIdle
    requires cache_present[m * NUM_VERS + dv]
    batch_slot = some(m * NUM_VERS + dv)
    stage_phase = DExtracting
    batch_model = selected_model
    batch_paused = false
    chunks_done = 0
    // MODEL-2 (vacuity idiom): records an automatic download iff extraction ever bypassed `cache_present`.
    auto_downloaded = auto_downloaded or not cache_present[m * NUM_VERS + dv]
  }

  fair action batch_build_fts_initial(m: ModuleId, dv: DepVer) "DES-DEP-3: initial extraction publishes FTS-only dependency pack while embeddings run" {
    requires batch_slot == some(m * NUM_VERS + dv)
    requires stage_phase == DExtracting
    requires not batch_paused
    requires batch_model == selected_model
    requires pack_state[m * NUM_VERS + dv] == DMissing
    stage_phase = DFTSBuilt
    pack_state[m * NUM_VERS + dv] = DFTSOnly
    if (answer_kind == DDepUncached or answer_kind == DDepUnindexed) and answer_mod == some(m) and answer_ver == some(dv) {
      answer_kind = DNoAnswer
      answer_mod = none
      answer_ver = none
      answer_card_count = 0
      answer_has_citation = false
      answer_has_scope = false
      answer_grounded = false
      answer_used_semantic = false
    }
  }

  fair action batch_build_fts_update(m: ModuleId, dv: DepVer) "DES-DEP-3: staged FTS rebuild for existing dependency pack leaves active pack untouched" {
    requires batch_slot == some(m * NUM_VERS + dv)
    requires stage_phase == DExtracting
    requires not batch_paused
    requires batch_model == selected_model
    requires pack_state[m * NUM_VERS + dv] != DMissing
    stage_phase = DFTSBuilt
  }

  action batch_pause() "DES-DEP-3: pause dependency batch preserving chunk checkpoint" {
    requires stage_phase != DIdle
    requires not batch_paused
    batch_paused = true
  }

  action batch_resume() "DES-DEP-3: resume paused dependency batch from checkpoint" {
    requires stage_phase != DIdle
    requires batch_paused
    requires batch_model == selected_model
    batch_paused = false
  }

  fair action batch_embed_chunk(m: ModuleId, dv: DepVer) "DES-DEP-3: embed or reuse one dependency chunk and checkpoint progress" {
    requires batch_slot == some(m * NUM_VERS + dv)
    requires stage_phase == DFTSBuilt
    requires not batch_paused
    requires batch_model == selected_model
    requires chunks_done < TOTAL_CHUNKS
    chunks_done = chunks_done + 1
    if chunks_done + 1 == TOTAL_CHUNKS { stage_phase = DEmbedded }
  }

  fair action batch_commit(m: ModuleId, dv: DepVer) "DES-DEP-3: atomically swap staged dependency pack to Ready" {
    requires batch_slot == some(m * NUM_VERS + dv)
    requires stage_phase == DEmbedded
    requires not batch_paused
    requires batch_model == selected_model
    requires pack_state[m * NUM_VERS + dv] != DMissing
    pack_state[m * NUM_VERS + dv] = DReady
    pack_model[m * NUM_VERS + dv] = selected_model
    batch_slot = none
    stage_phase = DIdle
    batch_paused = false
    chunks_done = 0
  }

  action batch_abort() "DES-DEP-3: discard staged dependency build without affecting active pack" {
    requires stage_phase != DIdle
    batch_slot = none
    stage_phase = DIdle
    batch_paused = false
    chunks_done = 0
  }

  action delete_dep_pack(m: ModuleId, dv: DepVer) "DES-DEP-1: remove dependency pack and cancel matching staging batch" {
    requires pack_state[m * NUM_VERS + dv] != DMissing
    pack_state[m * NUM_VERS + dv] = DMissing
    if batch_slot == some(m * NUM_VERS + dv) {
      batch_slot = none
      stage_phase = DIdle
      batch_paused = false
      chunks_done = 0
    }
    if answer_mod == some(m) and answer_ver == some(dv) {
      answer_kind = DNoAnswer
      answer_mod = none
      answer_ver = none
      answer_card_count = 0
      answer_has_citation = false
      answer_has_scope = false
      answer_grounded = false
      answer_used_semantic = false
    }
  }

  action select_embed_model(m: ModelId) "DES-DEP-1: switching embedding model aborts staging and demotes Ready dependency packs" {
    requires m != selected_model
    selected_model = m
    batch_slot = none
    stage_phase = DIdle
    batch_paused = false
    chunks_done = 0
    forall s: ModSlot {
      if pack_state[s] == DReady and pack_model[s] != m {
        pack_state[s] = DFTSOnly
      }
    }
    if answer_used_semantic {
      answer_kind = DNoAnswer
      answer_mod = none
      answer_ver = none
      answer_card_count = 0
      answer_has_citation = false
      answer_has_scope = false
      answer_grounded = false
      answer_used_semantic = false
    }
  }

  // MARK: - Unified version-exact & module-exact lookup (DES-DEP-2, DES-DEP-4, DES-DEP-5)

  action query_dep_found(
    m: ModuleId,
    dv: DepVer,
    use_semantic: Bool,
    card_count: CardCount
  ) "DES-DEP-2: return 1..MAX_CARDS grounded dependency cards strictly matching active go.mod/go.work (m, dv)" {
    requires enabled
    requires project_dep_ver[m] == some(dv)
    requires pack_state[m * NUM_VERS + dv] != DMissing
    requires card_count >= 1 and card_count <= MAX_CARDS
    requires (not use_semantic) or (pack_state[m * NUM_VERS + dv] == DReady and pack_model[m * NUM_VERS + dv] == selected_model)
    answer_kind = DDepCards
    answer_mod = some(m)
    answer_ver = some(dv)
    answer_card_count = card_count
    answer_has_citation = true
    answer_has_scope = true
    answer_grounded = true
    answer_used_semantic = use_semantic
    sent_remote = sent_remote or endpoint == Elsewhere
  }

  action query_dep_not_found(m: ModuleId, dv: DepVer) "DES-DEP-2: return honest Not Found when active dependency pack has no match" {
    requires enabled
    requires project_dep_ver[m] == some(dv)
    requires pack_state[m * NUM_VERS + dv] != DMissing
    answer_kind = DDepNotFound
    answer_mod = some(m)
    answer_ver = some(dv)
    answer_card_count = 0
    answer_has_citation = false
    answer_has_scope = true
    answer_grounded = true
    answer_used_semantic = pack_state[m * NUM_VERS + dv] == DReady and pack_model[m * NUM_VERS + dv] == selected_model
    sent_remote = sent_remote or endpoint == Elsewhere
  }

  action query_dep_unindexed(m: ModuleId, dv: DepVer) "DES-DEP-2: report cached-but-unindexed dependency without fabricating citations" {
    requires enabled
    requires project_dep_ver[m] == some(dv)
    requires cache_present[m * NUM_VERS + dv]
    requires pack_state[m * NUM_VERS + dv] == DMissing
    answer_kind = DDepUnindexed
    answer_mod = some(m)
    answer_ver = some(dv)
    answer_card_count = 0
    answer_has_citation = false
    answer_has_scope = true
    answer_grounded = true
    answer_used_semantic = false
  }

  action query_dep_uncached(m: ModuleId, dv: DepVer) "DES-DEP-2: report uncached dependency without substituting another version" {
    requires enabled
    requires project_dep_ver[m] == some(dv)
    requires not cache_present[m * NUM_VERS + dv]
    requires pack_state[m * NUM_VERS + dv] == DMissing
    answer_kind = DDepUncached
    answer_mod = some(m)
    answer_ver = some(dv)
    answer_card_count = 0
    answer_has_citation = false
    answer_has_scope = true
    answer_grounded = true
    answer_used_semantic = false
  }

  action insert_dep_card() "DES-DEP-2: insert grounded dependency snippet for active project's (module, version)" {
    requires enabled
    requires answer_kind == DDepCards
    requires answer_mod is some(m) and answer_ver is some(dv) and project_dep_ver[m] == some(dv)
    requires answer_has_citation and answer_grounded
    inserted = true
  }

  // MARK: - Invariants & Progress

  invariant EndpointIsLoopback "DES-DEP-1: validated endpoint is always loopback" {
    endpoint == Loopback
  }

  invariant NeverLeavesMachine "DES-DEP-1: no data ever leaves the machine" {
    not sent_remote
  }

  invariant NeverAutoDownloads "DES-DEP-2: no automatic network download ever runs" {
    not auto_downloaded
  }

  invariant BatchStateConsistent "DES-DEP-3: staging batch state, chunk progress, and FTS-before-Ready order stay consistent" {
    (stage_phase == DIdle => (batch_slot == none and not batch_paused and chunks_done == 0)) and
    (stage_phase != DIdle => (batch_slot != none and batch_model == selected_model)) and
    (stage_phase == DExtracting => chunks_done == 0) and
    (stage_phase == DFTSBuilt => (chunks_done < TOTAL_CHUNKS and batch_slot is some(s1) and pack_state[s1] != DMissing)) and
    (stage_phase == DEmbedded => (chunks_done == TOTAL_CHUNKS and batch_slot is some(s2) and pack_state[s2] != DMissing))
  }

  invariant DepCardsMatchActiveModuleAndVersion "MODEL-1: induction aid" {
    answer_kind == DDepCards => (
      enabled and
      answer_mod is some(m) and
      answer_ver is some(dv) and
      project_dep_ver[m] == some(dv) and
      pack_state[m * NUM_VERS + dv] != DMissing and
      answer_has_citation and
      answer_has_scope and
      answer_grounded
    )
  }

  invariant CardsBoundedByMax "MODEL-2: induction aid" {
    (answer_kind == DDepCards => (answer_card_count >= 1 and answer_card_count <= MAX_CARDS)) and
    (answer_kind != DDepCards => answer_card_count == 0)
  }

  invariant UnindexedReportedHonest "MODEL-3: induction aid" {
    answer_kind == DDepUnindexed => (
      enabled and
      answer_mod is some(m) and
      answer_ver is some(dv) and
      project_dep_ver[m] == some(dv) and
      cache_present[m * NUM_VERS + dv] and
      pack_state[m * NUM_VERS + dv] == DMissing and
      not answer_has_citation and
      answer_has_scope and
      answer_grounded
    )
  }

  invariant UncachedReportedWithoutSubstitution "MODEL-4: induction aid" {
    answer_kind == DDepUncached => (
      enabled and
      answer_mod is some(m) and
      answer_ver is some(dv) and
      project_dep_ver[m] == some(dv) and
      not cache_present[m * NUM_VERS + dv] and
      pack_state[m * NUM_VERS + dv] == DMissing and
      not answer_has_citation and
      answer_has_scope and
      answer_grounded
    )
  }

  invariant ReadyDepPackMatchesModel "MODEL-5: induction aid" {
    forall s: ModSlot { pack_state[s] == DReady => pack_model[s] == selected_model }
  }

  invariant SemanticRequiresMatchingModel "MODEL-6: induction aid" {
    answer_used_semantic => (
      answer_mod is some(m) and
      answer_ver is some(dv) and
      pack_state[m * NUM_VERS + dv] == DReady and
      pack_model[m * NUM_VERS + dv] == selected_model
    )
  }

  invariant DisabledHasNoAnswer "MODEL-7: induction aid" {
    not enabled => answer_kind == DNoAnswer
  }

  leadsTo DepBatchSettles "DES-DEP-3: an unpaused dependency ingestion batch eventually finishes or pauses" {
    (stage_phase != DIdle and not batch_paused) ~> (stage_phase == DIdle or batch_paused)
  }
}

verify {
  values ModuleId = 0..1
  values DepVer = 0..1
  values ModSlot = 0..3
  values ModelId = 0..1
  values ChunkDone = 0..1
  values CardCount = 0..3
}
