// og — Offline Go website snapshot corpus design (DocsCorpusExtractor + DocsPackManager + ResearchService)
//
// Refines: spec/req/docs_website.fsl (mapping: spec/design/docs_website_refines_req.fsl)
//
// DES-WEB-1: Website snapshot pack lives at `packs/website/` (`index.sqlite` + `manifest.json`)
//            with `DocsWebsitePackManifest` recording `snapshotDate`, `snapshotCommit`,
//            `sourceRepository` (`golang/website`), and `DocsLicense.goBSD3Clause`.
// DES-WEB-2: `DocsCorpusExtractor.extractWebsite(fromWebsiteRoot:snapshotDate:)` extracts heading-
//            scoped chunks from curated `golang/website/_content/` sources (Effective Go HTML,
//            Tour of Go `.article` + `.go` snippets, FAQ Markdown, Tutorials/Guides/Database/Modules/
//            Wiki Markdown & HTML, and technical Go Blog posts), excluding release notes (`go1.*.md`),
//            surveys/events/announcements, install/governance docs, and binary assets.
//            Every chunk uses `documentID = "website/<relPathWithoutExt>"` (zero FR-31 collision),
//            `provenance = .officialWebsiteSnapshot`, `sourceURL = "https://go.dev/..."`,
//            `snapshotDate`, and `since = nil` (excluded from `since` gate).
// DES-WEB-3: Staged ingestion runs in `staging/website/` through explicit phases
//            (`DIdle -> DExtracting -> DFTSBuilt -> DEmbedded`), publishes FTS-only on initial build,
//            supports chunk-level pause/resume/abort and `SharedVectorStore` reuse, and activates
//            atomically without corrupting any existing active website pack.
// DES-WEB-4: `ResearchService.search(...)` queries the website snapshot pack alongside the active
//            `packs/go<project_ver>` pack (only when `packs/go<project_ver>` is installed), passing
//            website candidates through the same Stage 2 reranker, anti-hallucination threshold,
//            and `MAX_CARDS = 3` cap while preserving stdlib priority on exact-symbol queries.
// DES-WEB-5: All model inference endpoints remain loopback-only (`EndpointIsLoopback`); no data
//            ever leaves the machine (`NeverLeavesMachine`).
//
// ASSUME-1 (representation only): two Go versions, two embedding models, TOTAL_CHUNKS = 2, MAX_CARDS = 3.
spec DocsWebsiteDesign {
  number GoVer
  number ModelId
  number ChunkDone
  number CardCount
  const TOTAL_CHUNKS = 2
  const MAX_CARDS = 3

  enum Host { Loopback, Elsewhere }
  enum DPackState { DMissing, DFTSOnly, DReady }
  enum DStagePhase { DIdle, DExtracting, DFTSBuilt, DEmbedded }
  enum DWebAnswerKind { DNoAnswer, DWebsiteCards, DWebsiteNotFound }

  state {
    endpoint:                       Host,
    enabled:                        Bool,
    project_ver:                    GoVer,
    go_pack_installed:              Map<GoVer, Bool>,
    website_pack_state:             DPackState,
    website_pack_model:             ModelId,
    website_has_snapshot_meta:      Bool,
    selected_model:                 ModelId,
    shared_cached:                  Bool,
    shared_model:                   ModelId,
    last_batch_reused:              Bool,
    // DES-WEB-3: staged chunk-level resumable ingestion state
    stage_phase:                    DStagePhase,
    batch_model:                    ModelId,
    batch_paused:                   Bool,
    chunks_done:                    ChunkDone,
    reused_in_batch:                Bool,
    // DES-WEB-4: answer state
    answer_kind:                    DWebAnswerKind,
    answer_ver:                     Option<GoVer>,
    answer_card_count:              CardCount,
    answer_has_snapshot_provenance: Bool,
    answer_has_scope:               Bool,
    answer_grounded:                Bool,
    answer_used_semantic:           Bool,
    answer_definition_exact:        Bool,
    answer_definition_first:        Bool,
    inserted:                       Bool,
    sent_remote:                    Bool       // MODEL-1: ghost — off-machine transmission
  }

  init {
    endpoint = Loopback
    enabled = false
    project_ver = 0
    website_pack_state = DMissing
    website_pack_model = 0
    website_has_snapshot_meta = false
    selected_model = 0
    shared_cached = false
    shared_model = 0
    last_batch_reused = false
    stage_phase = DIdle
    batch_model = 0
    batch_paused = false
    chunks_done = 0
    reused_in_batch = false
    answer_kind = DNoAnswer
    answer_ver = none
    answer_card_count = 0
    answer_has_snapshot_provenance = false
    answer_has_scope = false
    answer_grounded = false
    answer_used_semantic = false
    answer_definition_exact = false
    answer_definition_first = false
    inserted = false
    sent_remote = false
    forall v: GoVer {
      go_pack_installed[v] = false
    }
  }

  action set_endpoint(h: Host) "DES-WEB-5: only loopback endpoints are accepted" {
    requires h == Loopback
    endpoint = h
  }

  action enable() "DES-WEB-4: enable offline Go docs lookup" {
    requires not enabled
    enabled = true
  }

  action disable() "DES-WEB-4: disable lookup and clear website answers" {
    requires enabled
    enabled = false
    answer_kind = DNoAnswer
    answer_ver = none
    answer_card_count = 0
    answer_has_snapshot_provenance = false
    answer_has_scope = false
    answer_grounded = false
    answer_used_semantic = false
    answer_definition_exact = false
    answer_definition_first = false
  }

  action set_go_pack_installed(v: GoVer, present: Bool) "DES-WEB-4: update Go version pack availability" {
    requires present != go_pack_installed[v]
    go_pack_installed[v] = present
    if v == project_ver and not present {
      answer_kind = DNoAnswer
      answer_ver = none
      answer_card_count = 0
      answer_has_snapshot_provenance = false
      answer_has_scope = false
      answer_grounded = false
      answer_used_semantic = false
      answer_definition_exact = false
      answer_definition_first = false
    }
  }

  action set_project_version(v: GoVer) "DES-WEB-4: update active project Go version and clear stale answers" {
    requires v != project_ver
    project_ver = v
    answer_kind = DNoAnswer
    answer_ver = none
    answer_card_count = 0
    answer_has_snapshot_provenance = false
    answer_has_scope = false
    answer_grounded = false
    answer_used_semantic = false
    answer_definition_exact = false
    answer_definition_first = false
  }

  // MARK: - Staged website snapshot ingestion (DES-WEB-1, DES-WEB-2, DES-WEB-3)

  action batch_start() "DES-WEB-3: begin staged extraction of golang/website into staging/website" {
    requires stage_phase == DIdle
    stage_phase = DExtracting
    batch_model = selected_model
    batch_paused = false
    chunks_done = 0
    reused_in_batch = false
  }

  fair action batch_build_fts_initial() "DES-WEB-3: initial website extraction and FTS5 build expose FTS-only search with snapshot metadata" {
    requires stage_phase == DExtracting
    requires not batch_paused
    requires batch_model == selected_model
    requires website_pack_state == DMissing
    stage_phase = DFTSBuilt
    website_pack_state = DFTSOnly
    website_has_snapshot_meta = true
  }

  fair action batch_build_fts_update() "DES-WEB-3: staged FTS5 rebuild for website snapshot update keeps active pack untouched" {
    requires stage_phase == DExtracting
    requires not batch_paused
    requires batch_model == selected_model
    requires website_pack_state != DMissing
    stage_phase = DFTSBuilt
  }

  action batch_pause() "DES-WEB-3: pause website ingestion batch keeping chunk checkpoint and active pack intact" {
    requires stage_phase != DIdle
    requires not batch_paused
    batch_paused = true
  }

  action batch_resume() "DES-WEB-3: resume paused website batch from exact chunk checkpoint" {
    requires stage_phase != DIdle
    requires batch_paused
    requires batch_model == selected_model
    batch_paused = false
  }

  fair action batch_embed_chunk_reuse() "DES-WEB-3: reuse one chunk vector from SharedVectorStore" {
    requires stage_phase == DFTSBuilt
    requires not batch_paused
    requires batch_model == selected_model
    requires chunks_done < TOTAL_CHUNKS
    requires shared_cached and shared_model == selected_model
    chunks_done = chunks_done + 1
    reused_in_batch = true
    if chunks_done + 1 == TOTAL_CHUNKS { stage_phase = DEmbedded }
  }

  fair action batch_embed_chunk_compute() "DES-WEB-3: compute embedding for one uncached website chunk and checkpoint it" {
    requires stage_phase == DFTSBuilt
    requires not batch_paused
    requires batch_model == selected_model
    requires chunks_done < TOTAL_CHUNKS
    chunks_done = chunks_done + 1
    if chunks_done + 1 == TOTAL_CHUNKS { stage_phase = DEmbedded }
  }

  fair action batch_commit_compute() "DES-WEB-3: atomically swap staging/website into packs/website as Ready" {
    requires stage_phase == DEmbedded
    requires not batch_paused
    requires batch_model == selected_model
    requires not reused_in_batch
    requires website_pack_state != DMissing
    website_pack_state = DReady
    website_pack_model = selected_model
    website_has_snapshot_meta = true
    shared_cached = true
    shared_model = selected_model
    last_batch_reused = false
    stage_phase = DIdle
    batch_paused = false
    chunks_done = 0
    reused_in_batch = false
  }

  fair action batch_commit_reuse() "DES-WEB-3: atomically swap staging/website into packs/website as Ready after vector reuse" {
    requires stage_phase == DEmbedded
    requires not batch_paused
    requires batch_model == selected_model
    requires reused_in_batch
    requires website_pack_state != DMissing
    requires shared_cached and shared_model == selected_model
    website_pack_state = DReady
    website_pack_model = selected_model
    website_has_snapshot_meta = true
    last_batch_reused = true
    stage_phase = DIdle
    batch_paused = false
    chunks_done = 0
    reused_in_batch = false
  }

  action batch_abort() "DES-WEB-3: discard staging/website on failure without corrupting active website pack" {
    requires stage_phase != DIdle
    stage_phase = DIdle
    batch_paused = false
    chunks_done = 0
    reused_in_batch = false
  }

  action delete_website_pack() "DES-WEB-1: delete packs/website, cancel active website batch, and clear answers" {
    requires website_pack_state != DMissing
    website_pack_state = DMissing
    website_has_snapshot_meta = false
    stage_phase = DIdle
    batch_paused = false
    chunks_done = 0
    reused_in_batch = false
    answer_kind = DNoAnswer
    answer_ver = none
    answer_card_count = 0
    answer_has_snapshot_provenance = false
    answer_has_scope = false
    answer_grounded = false
    answer_used_semantic = false
    answer_definition_exact = false
    answer_definition_first = false
  }

  action select_embed_model(m: ModelId) "DES-WEB-3: switching embedding model aborts staging and demotes Ready website pack to FTS-only" {
    requires m != selected_model
    selected_model = m
    stage_phase = DIdle
    batch_paused = false
    chunks_done = 0
    reused_in_batch = false
    last_batch_reused = false
    if website_pack_state == DReady and website_pack_model != m {
      website_pack_state = DFTSOnly
    }
    if answer_used_semantic {
      answer_kind = DNoAnswer
      answer_ver = none
      answer_card_count = 0
      answer_has_snapshot_provenance = false
      answer_has_scope = false
      answer_grounded = false
      answer_used_semantic = false
      answer_definition_exact = false
      answer_definition_first = false
    }
  }

  // MARK: - Website search pipeline (DES-WEB-4, DES-WEB-5)

  action query_website_found(
    use_semantic: Bool,
    card_count: CardCount,
    definition_exact_match: Bool,
    definition_shown_first: Bool
  ) "DES-WEB-4: return 1..MAX_CARDS grounded website cards with snapshot provenance without displacing exact definitions" {
    requires enabled
    requires go_pack_installed[project_ver]
    requires website_pack_state != DMissing
    requires website_has_snapshot_meta
    requires card_count >= 1 and card_count <= MAX_CARDS
    requires (not definition_exact_match) or definition_shown_first
    requires (not use_semantic) or (website_pack_state == DReady and website_pack_model == selected_model)
    answer_kind = DWebsiteCards
    answer_ver = some(project_ver)
    answer_card_count = card_count
    answer_has_snapshot_provenance = true
    answer_has_scope = true
    answer_grounded = true
    answer_used_semantic = use_semantic
    answer_definition_exact = definition_exact_match
    answer_definition_first = definition_shown_first
    sent_remote = sent_remote or endpoint == Elsewhere
  }

  action query_website_not_found() "DES-WEB-4: return grounded Not Found with searched scope" {
    requires enabled
    requires go_pack_installed[project_ver]
    requires website_pack_state != DMissing
    answer_kind = DWebsiteNotFound
    answer_ver = some(project_ver)
    answer_card_count = 0
    answer_has_snapshot_provenance = false
    answer_has_scope = true
    answer_grounded = true
    answer_used_semantic = website_pack_state == DReady and website_pack_model == selected_model
    answer_definition_exact = false
    answer_definition_first = false
    sent_remote = sent_remote or endpoint == Elsewhere
  }

  action insert_website_snippet() "DES-WEB-4: insert grounded website code snippet into active Go editor" {
    requires enabled
    requires answer_kind == DWebsiteCards
    requires answer_ver == some(project_ver)
    requires answer_has_snapshot_provenance and answer_grounded
    inserted = true
  }

  // MARK: - Invariants & Progress

  invariant EndpointIsLoopback "DES-WEB-5: validated model endpoint is always loopback" {
    endpoint == Loopback
  }

  invariant NeverLeavesMachine "DES-WEB-5: no data ever leaves the machine" {
    not sent_remote
  }

  invariant BatchStateConsistent "DES-WEB-3: staging phases and chunk counter stay consistent" {
    (stage_phase == DIdle => (not batch_paused and chunks_done == 0 and not reused_in_batch)) and
    (stage_phase != DIdle => batch_model == selected_model) and
    (stage_phase == DExtracting => (chunks_done == 0 and not reused_in_batch)) and
    (stage_phase == DFTSBuilt => (chunks_done < TOTAL_CHUNKS and website_pack_state != DMissing)) and
    (stage_phase == DEmbedded => (chunks_done == TOTAL_CHUNKS and website_pack_state != DMissing))
  }

  invariant SharedReuseMatchesModel "DES-WEB-3: reused vectors always come from selected_model in SharedVectorStore" {
    (reused_in_batch => (shared_cached and shared_model == selected_model)) and
    (last_batch_reused => (shared_cached and shared_model == selected_model))
  }

  invariant WebsitePackAlwaysHasSnapshotMeta "DES-WEB-1: installed website pack carries snapshot metadata" {
    website_pack_state != DMissing => website_has_snapshot_meta
  }

  invariant ReadyWebsitePackMatchesModel "DES-WEB-3: Ready website pack was embedded with selected_model" {
    website_pack_state == DReady => website_pack_model == selected_model
  }

  invariant WebsiteCardsAlwaysHaveSnapshotProvenance "MODEL-2: induction aid" {
    answer_kind == DWebsiteCards => (
      enabled and
      go_pack_installed[project_ver] and
      website_pack_state != DMissing and
      website_has_snapshot_meta and
      answer_ver == some(project_ver) and
      answer_has_snapshot_provenance and
      answer_has_scope and
      answer_grounded
    )
  }

  invariant NarrativeNeverDisplacesExactDefinition "DES-WEB-4: exact definitions always rank ahead of website cards" {
    (answer_kind == DWebsiteCards and answer_definition_exact) => answer_definition_first
  }

  invariant NotFoundHasScopeWithoutCitation "MODEL-3: induction aid" {
    answer_kind == DWebsiteNotFound => (
      enabled and
      go_pack_installed[project_ver] and
      website_pack_state != DMissing and
      answer_ver == some(project_ver) and
      answer_grounded and
      answer_has_scope and
      not answer_has_snapshot_provenance
    )
  }

  invariant CardsBoundedByMax "MODEL-4: induction aid" {
    (answer_kind == DWebsiteCards => (answer_card_count >= 1 and answer_card_count <= MAX_CARDS)) and
    (answer_kind != DWebsiteCards => answer_card_count == 0)
  }

  invariant SemanticRequiresMatchingModel "MODEL-5: induction aid" {
    answer_used_semantic => (website_pack_state == DReady and website_pack_model == selected_model)
  }

  invariant DisabledHasNoAnswer "MODEL-6: induction aid" {
    not enabled => answer_kind == DNoAnswer
  }

  leadsTo WebsiteBatchSettles "DES-WEB-3: an unpaused website ingestion batch eventually finishes or pauses" {
    (stage_phase != DIdle and not batch_paused) ~> (stage_phase == DIdle or batch_paused)
  }
}

verify {
  values GoVer = 0..1
  values ModelId = 0..1
  values ChunkDone = 0..2
  values CardCount = 0..3
}
