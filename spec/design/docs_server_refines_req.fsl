// DocsServerDesign ⊑ DocsServer
// Process-group spawning, startup health timeout, windowed crash counting, and zombie reaping
// refine the requirements-level DocsServer lifecycle contract.
refinement DocsServerRefinesReq {
  impl DocsServerDesign
  abs  DocsServer
  maps auto

  map phase = if phase == DReady then Ready
              else if phase == DFailed then Failed
              else if phase == DOff then Off
              else Starting

  action spawned()            -> stutter
  action spawn_error()        -> start_failed()
  action health_ok()          -> became_ready()
  action health_timeout()     -> start_failed()
  action exit_while_loading() -> start_failed()
  action exit_while_ready()   -> crashed()
  action zombie_exit()        -> stutter
}
