// og — Offline Go documentation lookup design (DocsCorpus + DocsIndex + SharedVectorStore + ResearchService)
//
// Refines: spec/req/research.fsl (mapping: spec/design/research_refines_req.fsl)
//
// DES-1: The optional local model endpoint is validated on set; only loopback hosts
//        (127.0.0.1, ::1, localhost) are accepted and redirects off loopback are refused.
//        Offline FTS5 search makes zero network calls.
// DES-2: Ingestion batch runs in a staging directory through explicit phases
//        (DIdle -> DExtracting -> DFTSBuilt -> DEmbedded) and activates atomically.
//        Supports updating an already-Ready pack without disturbing active search, and
//        tracks chunk-level completion (`chunks_done`) so pause/resume skips finished chunks
//        (FR-6, FR-22..26).
// DES-3: Vectors are stored in SharedVectorStore keyed by (content_hash, model_id_ver).
//        When a new Go version or updated pack is built with the same model, unchanged chunks
//        reuse cached vectors without recomputation (FR-30, FR-31).
// DES-4: Switching embedding models invalidates staging and demotes Ready packs to FTS-only
//        until rebuilt so vectors from distinct models are never mixed (FR-27).
// DES-5: Retrieval follows a fixed two-stage deterministic pipeline:
//        (1) route -> pack check -> collect deterministic + FTS5 + semantic candidates
//            -> per-chunk `since` version gate -> balanced union pool capped at top N = 30
//            -> (2) optional local MLX cross-encoder reranking
//            -> anti-hallucination threshold -> max-3 grounded cards (`MAX_CARDS = 3`).
//        When the local MLX Docs server is disabled or unavailable, stage (2) is skipped and
//        retrieval falls back transparently to Phase 1 (FTS5 + deterministic).
// DES-6: The Docs inference server runs as a dedicated og-owned MLX loopback process (`uvx`)
//        formally specified in `spec/design/docs_server.fsl` (127.0.0.1:<free port>, own
//        process group, bounded health timeout, windowed crash restarts with backoff, clean
//        quit), serving both `/v1/embeddings` and `/v1/rerank`.
//
// ASSUME-1 (representation only): two Go versions, two embedding models, TOTAL_CHUNKS = 2.
spec ResearchDesign {
  number GoVer
  number ModelId
  number ChunkDone
  number CardCount
  const TOTAL_CHUNKS = 2
  const MAX_CARDS = 3

  enum Host { Loopback, Elsewhere }
  enum DPackState { DMissing, DFTSOnly, DReady }
  enum DStagePhase { DIdle, DExtracting, DFTSBuilt, DEmbedded }
  enum DAnswerKind { DNoAnswer, DGroundedCards, DGroundedNotFound, DMissingPack }
  enum RetrievalSource { RFTSOnly, RHybridUnion }

  state {
    endpoint:                Host,
    enabled:                 Bool,
    project_ver:             GoVer,
    pack_state:              Map<GoVer, DPackState>,
    pack_model:              Map<GoVer, ModelId>,
    selected_model:          ModelId,
    shared_cached:           Bool,
    shared_model:            ModelId,
    last_batch_reused:       Bool,
    llm_available:           Bool,
    reranker_available:      Bool,
    // DES-2: staging & chunk-level resumable batch state
    batch_ver:               Option<GoVer>,
    stage_phase:             DStagePhase,
    batch_model:             ModelId,
    batch_paused:            Bool,
    chunks_done:             ChunkDone,
    reused_in_batch:         Bool,
    // Answer state
    answer_kind:             DAnswerKind,
    answer_ver:              Option<GoVer>,
    answer_card_since:       Option<GoVer>,
    answer_card_count:       CardCount,
    answer_retrieval_source: RetrievalSource,
    answer_has_newer_notes:  Bool,
    answer_has_citation:     Bool,
    answer_has_scope:        Bool,
    answer_grounded:         Bool,
    answer_used_semantic:    Bool,
    answer_used_reranker:    Bool,
    inserted:                Bool,
    sent_remote:             Bool       // MODEL-1: ghost — off-machine transmission
  }

  init {
    endpoint = Loopback
    enabled = false
    project_ver = 0
    selected_model = 0
    shared_cached = false
    shared_model = 0
    last_batch_reused = false
    llm_available = false
    reranker_available = false
    batch_ver = none
    stage_phase = DIdle
    batch_model = 0
    batch_paused = false
    chunks_done = 0
    reused_in_batch = false
    answer_kind = DNoAnswer
    answer_ver = none
    answer_card_since = none
    answer_card_count = 0
    answer_retrieval_source = RFTSOnly
    answer_has_newer_notes = false
    answer_has_citation = false
    answer_has_scope = false
    answer_grounded = false
    answer_used_semantic = false
    answer_used_reranker = false
    inserted = false
    sent_remote = false
    forall v: GoVer {
      pack_state[v] = DMissing
      pack_model[v] = 0
    }
  }

  action set_endpoint(h: Host) "DES-1: only loopback endpoints are accepted for local models" {
    requires h == Loopback
    endpoint = h
  }

  action enable() "DES-DOC-1: enable offline Go docs lookup" {
    requires not enabled
    enabled = true
  }

  action disable() "DES-DOC-2: disable lookup and clear answers" {
    requires enabled
    enabled = false
    answer_kind = DNoAnswer
    answer_ver = none
    answer_card_since = none
    answer_card_count = 0
    answer_retrieval_source = RFTSOnly
    answer_has_newer_notes = false
    answer_has_citation = false
    answer_has_scope = false
    answer_grounded = false
    answer_used_semantic = false
    answer_used_reranker = false
  }

  action set_project_version(v: GoVer) "DES-DOC-3: update detected Go version from go.mod/go.work/toolchain" {
    requires v != project_ver
    project_ver = v
    answer_kind = DNoAnswer
    answer_ver = none
    answer_card_since = none
    answer_card_count = 0
    answer_retrieval_source = RFTSOnly
    answer_has_newer_notes = false
    answer_has_citation = false
    answer_has_scope = false
    answer_grounded = false
    answer_used_semantic = false
    answer_used_reranker = false
  }

  action toggle_llm(avail: Bool) "DES-DOC-4: update local LLM readiness" {
    requires avail != llm_available
    llm_available = avail
  }

  action toggle_reranker(avail: Bool) "DES-6: update local MLX cross-encoder reranker readiness" {
    requires avail != reranker_available
    reranker_available = avail
    if not avail and answer_used_reranker {
      answer_kind = DNoAnswer
      answer_ver = none
      answer_card_since = none
      answer_card_count = 0
      answer_retrieval_source = RFTSOnly
      answer_has_newer_notes = false
      answer_has_citation = false
      answer_has_scope = false
      answer_grounded = false
      answer_used_semantic = false
      answer_used_reranker = false
    }
  }

  action switch_rerank_model() "DES-6: switch cross-encoder reranker model without invalidating embedding vectors" {
    requires answer_used_reranker
    answer_kind = DNoAnswer
    answer_ver = none
    answer_card_since = none
    answer_card_count = 0
    answer_retrieval_source = RFTSOnly
    answer_has_newer_notes = false
    answer_has_citation = false
    answer_has_scope = false
    answer_grounded = false
    answer_used_semantic = false
    answer_used_reranker = false
  }

  // MARK: - Staging & chunk-level resumable ingestion / update batch (DES-2, DES-3)

  action batch_start(v: GoVer) "DES-2: begin staged pack ingestion or update for any version (including Ready) without disturbing active pack" {
    requires stage_phase == DIdle
    batch_ver = some(v)
    stage_phase = DExtracting
    batch_model = selected_model
    batch_paused = false
    chunks_done = 0
    reused_in_batch = false
  }

  fair action batch_build_fts_initial(v: GoVer) "DES-2: initial extraction and FTS5 build expose FTS-only search while embeddings run" {
    requires batch_ver == some(v)
    requires stage_phase == DExtracting
    requires not batch_paused
    requires batch_model == selected_model
    requires pack_state[v] == DMissing
    stage_phase = DFTSBuilt
    pack_state[v] = DFTSOnly
    if v == project_ver and answer_kind == DMissingPack {
      answer_kind = DNoAnswer
      answer_ver = none
      answer_card_since = none
      answer_card_count = 0
      answer_retrieval_source = RFTSOnly
      answer_has_newer_notes = false
      answer_has_citation = false
      answer_has_scope = false
      answer_grounded = false
      answer_used_semantic = false
      answer_used_reranker = false
    }
  }

  fair action batch_build_fts_update(v: GoVer) "DES-2: staged FTS5 build for updating an existing (FTSOnly or Ready) pack keeps active pack untouched" {
    requires batch_ver == some(v)
    requires stage_phase == DExtracting
    requires not batch_paused
    requires batch_model == selected_model
    requires pack_state[v] != DMissing
    stage_phase = DFTSBuilt
  }

  action batch_pause() "DES-2: cancel/pause background batch keeping chunk checkpoint and active pack intact" {
    requires stage_phase != DIdle
    requires not batch_paused
    batch_paused = true
  }

  action batch_resume() "DES-2: resume an interrupted batch from its exact chunk checkpoint without recomputing done chunks" {
    requires stage_phase != DIdle
    requires batch_paused
    requires batch_model == selected_model
    batch_paused = false
  }

  fair action batch_embed_chunk_reuse(v: GoVer) "DES-3: process one chunk by reusing its vector from SharedVectorStore" {
    requires batch_ver == some(v)
    requires stage_phase == DFTSBuilt
    requires not batch_paused
    requires batch_model == selected_model
    requires chunks_done < TOTAL_CHUNKS
    requires shared_cached and shared_model == selected_model
    chunks_done = chunks_done + 1
    reused_in_batch = true
    if chunks_done + 1 == TOTAL_CHUNKS { stage_phase = DEmbedded }
  }

  fair action batch_embed_chunk_compute(v: GoVer) "DES-2: compute embedding for one uncached chunk and checkpoint it" {
    requires batch_ver == some(v)
    requires stage_phase == DFTSBuilt
    requires not batch_paused
    requires batch_model == selected_model
    requires chunks_done < TOTAL_CHUNKS
    chunks_done = chunks_done + 1
    if chunks_done + 1 == TOTAL_CHUNKS { stage_phase = DEmbedded }
  }

  fair action batch_commit_compute(v: GoVer) "DES-2: atomically swap staging pack to Ready after computing embeddings" {
    requires batch_ver == some(v)
    requires stage_phase == DEmbedded
    requires not batch_paused
    requires batch_model == selected_model
    requires not reused_in_batch
    pack_state[v] = DReady
    pack_model[v] = selected_model
    shared_cached = true
    shared_model = selected_model
    last_batch_reused = false
    batch_ver = none
    stage_phase = DIdle
    batch_paused = false
    chunks_done = 0
    reused_in_batch = false
    if v == project_ver and answer_kind == DMissingPack {
      answer_kind = DNoAnswer
      answer_ver = none
      answer_card_since = none
      answer_card_count = 0
      answer_retrieval_source = RFTSOnly
      answer_has_newer_notes = false
      answer_has_citation = false
      answer_has_scope = false
      answer_grounded = false
      answer_used_semantic = false
      answer_used_reranker = false
    }
  }

  fair action batch_commit_reuse(v: GoVer) "DES-3: atomically swap staging pack to Ready having reused vectors from SharedVectorStore" {
    requires batch_ver == some(v)
    requires stage_phase == DEmbedded
    requires not batch_paused
    requires batch_model == selected_model
    requires reused_in_batch
    requires shared_cached and shared_model == selected_model
    pack_state[v] = DReady
    pack_model[v] = selected_model
    last_batch_reused = true
    batch_ver = none
    stage_phase = DIdle
    batch_paused = false
    chunks_done = 0
    reused_in_batch = false
    if v == project_ver and answer_kind == DMissingPack {
      answer_kind = DNoAnswer
      answer_ver = none
      answer_card_since = none
      answer_card_count = 0
      answer_retrieval_source = RFTSOnly
      answer_has_newer_notes = false
      answer_has_citation = false
      answer_has_scope = false
      answer_grounded = false
      answer_used_semantic = false
      answer_used_reranker = false
    }
  }

  action batch_abort() "DES-2: discard staging directory on failure without corrupting active pack" {
    requires stage_phase != DIdle
    batch_ver = none
    stage_phase = DIdle
    batch_paused = false
    chunks_done = 0
    reused_in_batch = false
  }

  action delete_pack(v: GoVer) "DES-DOC-5: delete an installed pack (cancels staging if targeting the same version)" {
    requires pack_state[v] != DMissing
    pack_state[v] = DMissing
    if batch_ver == some(v) {
      batch_ver = none
      stage_phase = DIdle
      batch_paused = false
      chunks_done = 0
      reused_in_batch = false
    }
    if v == project_ver {
      answer_kind = DNoAnswer
      answer_ver = none
      answer_card_since = none
      answer_card_count = 0
      answer_retrieval_source = RFTSOnly
      answer_has_newer_notes = false
      answer_has_citation = false
      answer_has_scope = false
      answer_grounded = false
      answer_used_semantic = false
      answer_used_reranker = false
    }
  }

  action select_embed_model(m: ModelId) "DES-4: changing embedding model invalidates staging and demotes Ready packs to FTS-only" {
    requires m != selected_model
    selected_model = m
    batch_ver = none
    stage_phase = DIdle
    batch_paused = false
    chunks_done = 0
    reused_in_batch = false
    last_batch_reused = false
    forall v: GoVer {
      if pack_state[v] == DReady and pack_model[v] != m {
        pack_state[v] = DFTSOnly
      }
    }
    if answer_used_semantic {
      answer_kind = DNoAnswer
      answer_ver = none
      answer_card_since = none
      answer_card_count = 0
      answer_retrieval_source = RFTSOnly
      answer_has_newer_notes = false
      answer_has_citation = false
      answer_has_scope = false
      answer_grounded = false
      answer_used_semantic = false
      answer_used_reranker = false
    }
  }

  // MARK: - Fixed two-stage retrieval pipeline (DES-5, DES-6)

  action query_found(
    card_since: GoVer,
    has_newer_feature: Bool,
    source: RetrievalSource,
    card_count: CardCount
  ) "DES-5: fixed two-stage pipeline returns 1..MAX_CARDS grounded, cited, since-gated, threshold-verified cards from top-N union pool with optional local reranking" {
    requires enabled
    requires pack_state[project_ver] != DMissing
    requires card_since <= project_ver
    requires card_count >= 1 and card_count <= MAX_CARDS
    requires source == RFTSOnly or (pack_state[project_ver] == DReady and pack_model[project_ver] == selected_model)
    answer_kind = DGroundedCards
    answer_ver = some(project_ver)
    answer_card_since = some(card_since)
    answer_card_count = card_count
    answer_retrieval_source = source
    answer_has_newer_notes = has_newer_feature
    answer_has_citation = true
    answer_has_scope = true
    answer_grounded = true
    answer_used_semantic = source != RFTSOnly
    answer_used_reranker = reranker_available
    sent_remote = sent_remote or endpoint == Elsewhere
  }

  action query_not_found(has_newer_feature: Bool) "DES-5: return grounded Not Found with searched scope when zero version-gated matches pass threshold" {
    requires enabled
    requires pack_state[project_ver] != DMissing
    answer_kind = DGroundedNotFound
    answer_ver = some(project_ver)
    answer_card_since = none
    answer_card_count = 0
    answer_retrieval_source = if pack_state[project_ver] == DReady and pack_model[project_ver] == selected_model then RHybridUnion else RFTSOnly
    answer_has_newer_notes = has_newer_feature
    answer_has_citation = false
    answer_has_scope = true
    answer_grounded = true
    answer_used_semantic = pack_state[project_ver] == DReady and pack_model[project_ver] == selected_model
    answer_used_reranker = false
    sent_remote = sent_remote or endpoint == Elsewhere
  }

  action query_missing_pack() "DES-5: return MissingPack when project_ver has no installed pack" {
    requires enabled
    requires pack_state[project_ver] == DMissing
    answer_kind = DMissingPack
    answer_ver = some(project_ver)
    answer_card_since = none
    answer_card_count = 0
    answer_retrieval_source = RFTSOnly
    answer_has_newer_notes = false
    answer_has_citation = false
    answer_has_scope = true
    answer_grounded = true
    answer_used_semantic = false
    answer_used_reranker = false
  }

  action insert_card() "DES-DOC-6: insert version-gated grounded code snippet into the active editor" {
    requires enabled
    requires answer_kind == DGroundedCards
    requires answer_ver == some(project_ver)
    requires answer_card_since is some(s) and s <= project_ver
    requires answer_grounded
    inserted = true
  }

  // MARK: - Invariants & Progress

  invariant EndpointIsLoopback "DES-1: validated model endpoint is always loopback" {
    endpoint == Loopback
  }

  invariant NeverLeavesMachine "DES-1: no data ever leaves the machine" {
    not sent_remote
  }

  invariant BatchStateConsistent "DES-2: active batch targets a version, tracks chunks cleanly, and uses selected_model" {
    (stage_phase == DIdle => (batch_ver == none and not batch_paused and chunks_done == 0 and not reused_in_batch)) and
    (stage_phase != DIdle => (batch_ver != none and batch_model == selected_model)) and
    (stage_phase == DExtracting => (chunks_done == 0 and not reused_in_batch)) and
    (stage_phase == DFTSBuilt => chunks_done < TOTAL_CHUNKS) and
    (stage_phase == DEmbedded => chunks_done == TOTAL_CHUNKS)
  }

  invariant SharedReuseMatchesModel "DES-3: reused vectors always come from a matching model in SharedVectorStore" {
    (reused_in_batch => (shared_cached and shared_model == selected_model)) and
    (last_batch_reused => (shared_cached and shared_model == selected_model))
  }

  invariant ReadyPackMatchesModel "DES-4: every Ready pack was embedded with selected_model" {
    forall v: GoVer { pack_state[v] == DReady => pack_model[v] == selected_model }
  }

  invariant CardsAlwaysCitedAndVersionGated "MODEL-2: induction aid" {
    answer_kind == DGroundedCards => (
      answer_has_citation and answer_has_scope and answer_grounded and
      answer_card_since is some(s) and s <= project_ver
    )
  }

  invariant NotFoundHasScopeWithoutCitation "MODEL-3: induction aid" {
    answer_kind == DGroundedNotFound => (
      answer_grounded and answer_has_scope and not answer_has_citation and
      answer_card_since == none and answer_ver == some(project_ver)
    )
  }

  invariant AnswerMatchesProjectVersion "MODEL-4: induction aid" {
    answer_kind != DNoAnswer => answer_ver == some(project_ver)
  }

  invariant NeverAnswersWithoutMatchingPack "MODEL-5: induction aid" {
    (answer_kind == DGroundedCards or answer_kind == DGroundedNotFound) => pack_state[project_ver] != DMissing
  }

  invariant SemanticRequiresMatchingModel "MODEL-6: induction aid" {
    answer_used_semantic => (pack_state[project_ver] == DReady and pack_model[project_ver] == selected_model)
  }

  invariant DisabledHasNoAnswer "MODEL-7: induction aid" {
    not enabled => (answer_kind == DNoAnswer and not answer_used_reranker)
  }

  invariant RerankRequiresAvailableAndGroundedCards "DES-5: reranking is reported only for grounded cards when the local reranker is ready" {
    answer_used_reranker => (enabled and reranker_available and answer_kind == DGroundedCards)
  }

  invariant CardsBoundedByMax "DES-5: grounded answers return 1..MAX_CARDS cards and non-card answers carry 0" {
    (answer_kind == DGroundedCards => (answer_card_count >= 1 and answer_card_count <= MAX_CARDS)) and
    (answer_kind != DGroundedCards => answer_card_count == 0)
  }

  invariant RetrievalSourceMatchesSemantic "DES-5: semantic/hybrid retrieval requires a Ready pack matching selected_model" {
    answer_used_semantic == (answer_retrieval_source != RFTSOnly) and
    (answer_retrieval_source != RFTSOnly => (pack_state[project_ver] == DReady and pack_model[project_ver] == selected_model))
  }

  leadsTo BatchSettles "DES-2: an unpaused ingestion batch eventually finishes or pauses" {
    (stage_phase != DIdle and not batch_paused) ~> (stage_phase == DIdle or batch_paused)
  }
}

verify {
  values GoVer = 0..1
  values ModelId = 0..1
  values ChunkDone = 0..2
  values CardCount = 0..3
}
