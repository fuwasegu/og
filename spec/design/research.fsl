// og — Offline Go documentation lookup design (DocsCorpus + DocsIndex + SharedVectorStore + ResearchService)
//
// Refines: spec/req/research.fsl (mapping: spec/design/research_refines_req.fsl)
//
// DES-1: The optional local model endpoint is validated on set; only loopback hosts
//        (127.0.0.1, ::1, localhost) are accepted. Offline FTS5 search makes zero network calls.
// DES-2: Ingestion batch runs in a staging directory through explicit phases
//        (BIdle -> BExtracting -> BFTSBuilt -> BEmbedded) and activates atomically.
//        Cancellation or failure keeps any active pack untouched and preserves checkpoint
//        progress for resume (FR-22..26).
// DES-3: Vectors are stored in SharedVectorStore keyed by (content_hash, model_id_ver).
//        When a new Go version pack is built with the same model, unchanged chunks reuse
//        cached vectors without recomputation (FR-30, FR-31).
// DES-4: Switching embedding models marks active packs as FTS-only until rebuilt so
//        vectors from distinct models are never mixed (FR-27).
// DES-5: Retrieval follows a fixed deterministic pipeline (route -> version gate ->
//        deterministic/FTS5/semantic merge -> grounded card rendering), never an unbounded loop.
//
// ASSUME-1 (representation only): two Go versions and two embedding models.
spec ResearchDesign {
  number GoVer
  number ModelId

  enum Host { Loopback, Elsewhere }
  enum DPackState { DMissing, DFTSOnly, DReady }
  enum BatchPhase { BIdle, BExtracting, BFTSBuilt, BEmbedded }
  enum DAnswerKind { DNoAnswer, DGroundedCards, DGroundedNotFound, DMissingPack }

  state {
    endpoint:             Host,
    enabled:              Bool,
    project_ver:          GoVer,
    pack_state:           Map<GoVer, DPackState>,
    pack_model:           Map<GoVer, ModelId>,
    selected_model:       ModelId,
    shared_cached:        Bool,
    shared_model:         ModelId,
    llm_available:        Bool,
    // DES-2: staging & resumable batch state
    batch_ver:            Option<GoVer>,
    batch_phase:          BatchPhase,
    batch_model:          ModelId,
    batch_paused:         Bool,
    reused_from_shared:   Bool,
    // Answer state
    answer_kind:          DAnswerKind,
    answer_ver:           Option<GoVer>,
    answer_has_citation:  Bool,
    answer_grounded:      Bool,
    answer_version_gated: Bool,
    answer_used_semantic: Bool,
    inserted:             Bool,
    sent_remote:          Bool       // MODEL-1: ghost — off-machine transmission
  }

  init {
    endpoint = Loopback
    enabled = false
    project_ver = 0
    selected_model = 0
    shared_cached = false
    shared_model = 0
    llm_available = false
    batch_ver = none
    batch_phase = BIdle
    batch_model = 0
    batch_paused = false
    reused_from_shared = false
    answer_kind = DNoAnswer
    answer_ver = none
    answer_has_citation = false
    answer_grounded = false
    answer_version_gated = false
    answer_used_semantic = false
    inserted = false
    sent_remote = false
    forall v: GoVer {
      pack_state[v] = DMissing
      pack_model[v] = 0
    }
  }

  action set_endpoint(h: Host) "DES-1: only loopback endpoints are accepted for local models" {
    requires h == Loopback
    endpoint = h
  }

  action enable() "DES-DOC-1: enable offline Go docs lookup" {
    requires not enabled
    enabled = true
  }

  action disable() "DES-DOC-2: disable lookup and clear answers" {
    requires enabled
    enabled = false
    answer_kind = DNoAnswer
    answer_ver = none
    answer_has_citation = false
    answer_grounded = false
    answer_version_gated = false
    answer_used_semantic = false
  }

  action set_project_version(v: GoVer) "DES-DOC-3: update detected Go version from go.mod/go.work/toolchain" {
    requires v != project_ver
    project_ver = v
    answer_kind = DNoAnswer
    answer_ver = none
    answer_has_citation = false
    answer_grounded = false
    answer_version_gated = false
    answer_used_semantic = false
  }

  action toggle_llm(avail: Bool) "DES-DOC-4: update local LLM readiness" {
    requires avail != llm_available
    llm_available = avail
  }

  // MARK: - Staging & resumable ingestion batch (DES-2, DES-3)

  action batch_start(v: GoVer) "DES-2: begin staged pack ingestion for version v without disturbing any active pack" {
    requires batch_phase == BIdle
    requires pack_state[v] != DReady
    batch_ver = some(v)
    batch_phase = BExtracting
    batch_model = selected_model
    batch_paused = false
    reused_from_shared = false
  }

  action batch_build_fts_initial(v: GoVer) "DES-2: initial extraction and FTS5 build expose FTS-only search while embeddings run" {
    requires batch_ver == some(v)
    requires batch_phase == BExtracting
    requires not batch_paused
    requires batch_model == selected_model
    requires pack_state[v] == DMissing
    batch_phase = BFTSBuilt
    pack_state[v] = DFTSOnly
    if v == project_ver and answer_kind == DMissingPack {
      answer_kind = DNoAnswer
      answer_ver = none
      answer_has_citation = false
      answer_grounded = false
      answer_version_gated = false
      answer_used_semantic = false
    }
  }

  action batch_build_fts_update(v: GoVer) "DES-2: staged FTS5 rebuild for an existing pack keeps active pack untouched" {
    requires batch_ver == some(v)
    requires batch_phase == BExtracting
    requires not batch_paused
    requires batch_model == selected_model
    requires pack_state[v] != DMissing
    batch_phase = BFTSBuilt
  }

  action batch_pause() "DES-2: cancel/pause background batch keeping checkpoint and active pack intact" {
    requires batch_phase == BExtracting or batch_phase == BFTSBuilt
    requires not batch_paused
    batch_paused = true
  }

  action batch_resume() "DES-2: resume an interrupted batch from its last completed phase" {
    requires batch_phase == BExtracting or batch_phase == BFTSBuilt
    requires batch_paused
    requires batch_model == selected_model
    batch_paused = false
  }

  action batch_embed_reuse(v: GoVer) "DES-3: reuse matching vectors from SharedVectorStore for unchanged chunks" {
    requires batch_ver == some(v)
    requires batch_phase == BFTSBuilt
    requires not batch_paused
    requires batch_model == selected_model
    requires shared_cached and shared_model == selected_model
    batch_phase = BEmbedded
    reused_from_shared = true
  }

  action batch_embed_compute(v: GoVer) "DES-2: compute embeddings for remaining uncached chunks" {
    requires batch_ver == some(v)
    requires batch_phase == BFTSBuilt
    requires not batch_paused
    requires batch_model == selected_model
    batch_phase = BEmbedded
    reused_from_shared = false
  }

  action batch_commit(v: GoVer) "DES-2: atomically swap staging pack to active Ready state and record vectors in shared store" {
    requires batch_ver == some(v)
    requires batch_phase == BEmbedded
    requires batch_model == selected_model
    requires pack_state[v] != DReady
    pack_state[v] = DReady
    pack_model[v] = selected_model
    shared_cached = true
    shared_model = selected_model
    batch_ver = none
    batch_phase = BIdle
    batch_paused = false
    if v == project_ver and answer_kind == DMissingPack {
      answer_kind = DNoAnswer
      answer_ver = none
      answer_has_citation = false
      answer_grounded = false
      answer_version_gated = false
      answer_used_semantic = false
    }
  }

  action batch_abort() "DES-2: discard staging directory on fatal error without corrupting active pack" {
    requires batch_phase != BIdle
    batch_ver = none
    batch_phase = BIdle
    batch_paused = false
    reused_from_shared = false
  }

  action delete_pack(v: GoVer) "DES-DOC-5: delete an installed pack (cancels staging if targeting the same version)" {
    requires pack_state[v] != DMissing
    pack_state[v] = DMissing
    if batch_ver == some(v) {
      batch_ver = none
      batch_phase = BIdle
      batch_paused = false
      reused_from_shared = false
    }
    if v == project_ver {
      answer_kind = DNoAnswer
      answer_ver = none
      answer_has_citation = false
      answer_grounded = false
      answer_version_gated = false
      answer_used_semantic = false
    }
  }

  action select_embed_model(m: ModelId) "DES-4: changing embedding model invalidates staging and demotes Ready packs to FTS-only" {
    requires m != selected_model
    selected_model = m
    batch_ver = none
    batch_phase = BIdle
    batch_paused = false
    reused_from_shared = false
    forall v: GoVer {
      if pack_state[v] == DReady and pack_model[v] != m {
        pack_state[v] = DFTSOnly
      }
    }
    if answer_used_semantic {
      answer_kind = DNoAnswer
      answer_ver = none
      answer_has_citation = false
      answer_grounded = false
      answer_version_gated = false
      answer_used_semantic = false
    }
  }

  // MARK: - Fixed retrieval pipeline (DES-5)

  action query_found() "DES-5: run fixed pipeline against validated loopback endpoint and project_ver pack" {
    requires enabled
    requires pack_state[project_ver] != DMissing
    answer_kind = DGroundedCards
    answer_ver = some(project_ver)
    answer_has_citation = true
    answer_grounded = true
    answer_version_gated = true
    answer_used_semantic = pack_state[project_ver] == DReady and pack_model[project_ver] == selected_model
    sent_remote = sent_remote or endpoint == Elsewhere
  }

  action query_not_found() "DES-5: return grounded Not Found when fixed pipeline yields zero version-gated matches" {
    requires enabled
    requires pack_state[project_ver] != DMissing
    answer_kind = DGroundedNotFound
    answer_ver = some(project_ver)
    answer_has_citation = true
    answer_grounded = true
    answer_version_gated = true
    answer_used_semantic = pack_state[project_ver] == DReady and pack_model[project_ver] == selected_model
    sent_remote = sent_remote or endpoint == Elsewhere
  }

  action query_missing_pack() "DES-5: return MissingPack when project_ver has no installed pack" {
    requires enabled
    requires pack_state[project_ver] == DMissing
    answer_kind = DMissingPack
    answer_ver = some(project_ver)
    answer_has_citation = false
    answer_grounded = true
    answer_version_gated = false
    answer_used_semantic = false
  }

  action insert_card() "DES-DOC-6: insert version-gated grounded code snippet into the active editor" {
    requires enabled
    requires answer_kind == DGroundedCards
    requires answer_ver == some(project_ver)
    requires answer_grounded
    requires answer_version_gated
    inserted = true
  }

  invariant EndpointIsLoopback "DES-1: validated model endpoint is always loopback" {
    endpoint == Loopback
  }

  invariant NeverLeavesMachine "DES-1: no data ever leaves the machine" {
    not sent_remote
  }

  invariant BatchStateConsistent "DES-2: active batch always targets a version and uses the selected model" {
    (batch_phase == BIdle => batch_ver == none) and
    (batch_phase != BIdle => (batch_ver != none and batch_model == selected_model))
  }

  invariant SharedReuseMatchesModel "DES-3: reused vectors always come from a matching model in SharedVectorStore" {
    (batch_phase == BEmbedded and reused_from_shared) => (shared_cached and shared_model == selected_model)
  }

  invariant ReadyPackMatchesModel "DES-4: every Ready pack was embedded with selected_model" {
    forall v: GoVer { pack_state[v] == DReady => pack_model[v] == selected_model }
  }

  invariant CardsAlwaysCitedAndGrounded "MODEL-2: induction aid" {
    answer_kind == DGroundedCards => (answer_has_citation and answer_grounded and answer_version_gated)
  }

  invariant NotFoundAlwaysGrounded "MODEL-3: induction aid" {
    answer_kind == DGroundedNotFound => (answer_grounded and answer_has_citation and answer_ver == some(project_ver))
  }

  invariant AnswerMatchesProjectVersion "MODEL-4: induction aid" {
    answer_kind != DNoAnswer => answer_ver == some(project_ver)
  }

  invariant NeverAnswersWithoutMatchingPack "MODEL-5: induction aid" {
    (answer_kind == DGroundedCards or answer_kind == DGroundedNotFound) => pack_state[project_ver] != DMissing
  }

  invariant SemanticRequiresMatchingModel "MODEL-6: induction aid" {
    answer_used_semantic => (pack_state[project_ver] == DReady and pack_model[project_ver] == selected_model)
  }

  invariant DisabledHasNoAnswer "MODEL-7: induction aid" {
    not enabled => answer_kind == DNoAnswer
  }
}

verify {
  values GoVer = 0..1
  values ModelId = 0..1
}
